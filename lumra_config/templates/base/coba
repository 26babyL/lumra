              x-cloak
              class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-red-500 rounded-full"
              style="border: 2px solid var(--sidebar-base);"></span>
      </div>
      <span x-show="open" x-transition class="flex-1 truncate">Notifications</span>
      {% if notifications_count %}
      <span x-show="open" x-transition class="ml-auto notif-badge">{{ notifications_count }}</span>
      {% endif %}
      <span class="nav-tooltip">Notifications</span>
    </a>

    <div x-data="{ isOpen: false }" x-init="isOpen = $root.menu === 'settings'">
      <button @click="isOpen = !isOpen; $root.menu = isOpen ? 'settings' : null" :aria-expanded="isOpen.toString()" class="nav-item w-full" :class="[isChildActive(['/settings/', '/users/', '/business-settings/', '/email-settings/', '/notification-settings/', '/system-status/', '/about/', '/permissions/', '/numbering/', '/backup/', '/api/']) ? 'parent-active' : '', !open ? 'collapsed justify-center' : '']">
        <div class="nav-icon-wrap"><svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
        <span x-show="open" x-transition class="flex-1 truncate text-left">Settings</span>
        <svg x-show="open" class="nav-icon chevron w-4 h-4" :class="{ 'open': isOpen }" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        <span class="nav-tooltip">Settings</span>
      </button>
      <div x-show="isOpen && open" x-collapse class="submenu-container pl-2">
        <div class="py-1 space-y-0.5 max-h-[300px] overflow-y-auto submenu-scroll pr-1">
          <a href="{% url 'users_list' %}" class="sub-item" :class="isActive('/settings/users') ? 'active' : ''">Users & Roles</a>
          <a href="{% url 'permission_matrix' %}" class="sub-item" :class="isActive('/settings/permissions') ? 'active' : ''">Permissions</a>
          <a href="{% url 'business_profile' %}" class="sub-item" :class="isActive('/settings/business') ? 'active' : ''">Business Profile</a>
          <a href="{% url 'email_settings' %}" class="sub-item" :class="isActive('/settings/email') ? 'active' : ''">Email Settings</a>
          <a href="{% url 'notification_settings' %}" class="sub-item" :class="isActive('/settings/notifications') ? 'active' : ''">Notification Settings</a>
          <a href="{% url 'numbering_settings' %}" class="sub-item" :class="isActive('/settings/numbering') ? 'active' : ''">Numbering</a>
          <a href="{% url 'backup_restore' %}" class="sub-item" :class="isActive('/settings/backup') ? 'active' : ''">Backup & Restore</a>
          <a href="{% url 'api_keys' %}" class="sub-item" :class="isActive('/settings/api') ? 'active' : ''">API Keys</a>
          <a href="{% url 'system_status' %}" class="sub-item" :class="isActive('/settings/system') ? 'active' : ''">System Status</a>
          <a href="{% url 'about' %}" class="sub-item" :class="isActive('/settings/about') ? 'active' : ''">About</a>
        </div>
      </div>
    </div>

  </nav>

  <!-- ── FOOTER: User Profile ── -->
  <div class="flex-shrink-0 border-t border-emerald-800/60 px-3 py-3">
    <div class="flex items-center gap-3"
         :class="open ? '' : 'justify-center'">

      <!-- ✨ FIX: Avatar with proper tooltip wrapper -->
      <div class="avatar-wrapper relative flex-shrink-0">
        <a href="{% url 'profile' %}" class="cursor-pointer block">
          <img src="{{ user.profile.avatar.url|default:'/static/img/default-avatar.png' }}"
               class="w-8 h-8 rounded-full ring-1 ring-emerald-500/50 object-cover hover:ring-emerald-300 transition-all duration-200"
               alt="{{ user.get_full_name|default:user.username }}"
               loading="lazy"
               onerror="this.src='/static/img/default-avatar.png'">
          <span class="online-dot"></span>
        </a>
        <span class="nav-tooltip" x-show="!open" x-cloak>
          {{ user.get_full_name|default:user.username }}
        </span>
      </div>

      <!-- User info + logout -->
      <div x-show="open"
           x-transition:enter="transition duration-200 ease-out"
           x-transition:enter-start="opacity-0 -translate-x-2"
           x-transition:enter-end="opacity-100 translate-x-0"
           x-transition:leave="transition duration-150 ease-in"
           x-transition:leave-end="opacity-0 -translate-x-2"
           class="flex-1 min-w-0 flex items-center justify-between gap-2">

        <div class="min-w-0">
          <a href="{% url 'profile' %}"
             class="block text-[13px] font-semibold text-emerald-50 truncate hover:text-emerald-300 transition-colors leading-tight">
            {{ user.get_full_name|default:user.username }}
          </a>
          <p class="text-[11px] text-emerald-200/60 truncate leading-tight mt-0.5">
            {{ user.profile.role|default:"Admin" }}
          </p>
        </div>

        <!-- ✨ FIX: Proper dark mode logout button -->
        <a href="{% url 'logout' %}"
           class="logout-btn"
           title="Keluar"
           aria-label="Keluar dari sistem">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- ✨ FIX: Mobile overlay with proper z-index -->
  <div class="md:hidden fixed inset-0 bg-black/50 backdrop-blur-sm mobile-overlay"
       x-show="open && mobile"
       x-cloak
       x-transition:enter="transition-opacity duration-300 ease-out"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition-opacity duration-200 ease-in"
       x-transition:leave-end="opacity-0"
       @click="open = false"
       aria-hidden="true">
  </div>

</aside>