{% load tailwind_tags %}
{% load static %}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dashboard{% endblock %}</title>

    {% tailwind_css %}

    <!-- Critical preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Google Fonts (async) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"></noscript>

    <!-- Font Awesome (async) -->
    <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer"></noscript>

    {% block extra_head %}{% endblock %}
    {% block extra_css %}{% endblock %}

    {% block chart_scripts %}{% endblock %}

    <style>
        :root {
            --sidebar-collapsed-width: 72px;
            --sidebar-expanded-width: 260px;
            --navbar-height: 60px;

            /* ── Navbar Colors ── */
            --jade:          #00A86B;
            --jade-light:    rgba(0,168,107,0.09);
            --jade-ring:     rgba(0,168,107,0.22);
            --jade-glow:     rgba(0,168,107,0.14);

            --nav-h:         60px;
            --nav-bg:        #ffffff;
            --nav-border:    rgba(0,0,0,0.07);
            --nav-shadow:    0 1px 0 rgba(226,232,240,0.9), 0 4px 20px rgba(15,23,42,0.05);

            --text-primary:   #0f172a;
            --text-secondary: #475569;
            --text-muted:     #94a3b8;
            --text-faint:     #cbd5e1;
            --sidebar-text-faint: rgba(110,231,183,0.25);

            --surface:        #f8fafc;
            --surface-hover:  rgba(0,168,107,0.05);
            --surface-active: rgba(0,168,107,0.09);

            --dd-bg:     #ffffff;
            --dd-border: rgba(0,0,0,0.07);
            --dd-shadow: 0 12px 40px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05);

            --divider: rgba(0,0,0,0.06);
            --danger:  #ef4444;
            --danger-glow: rgba(239,68,68,0.3);

            --ease: cubic-bezier(0.16,1,0.3,1);
            --dur:  0.22s;

            /* ── Sidebar Colors ── */
            --emerald-300: #6ee7b7;
            --emerald-400: #34d399;
            --emerald-500: #10b981;
            --emerald-600: #059669;
            --emerald-700: #047857;
            --sidebar-bg: #063d2f;
            --sidebar-surface: rgba(255,255,255,0.05);
            --sidebar-border: rgba(52,211,153,0.12);
            --sidebar-hover: rgba(255,255,255,0.07);
            --sidebar-active-bg: rgba(16,185,129,0.18);
            --sidebar-active-glow: rgba(16,185,129,0.08);
            --text-main: #ecfdf5;
            --text-dim: rgba(110,231,183,0.45);
            --text-faint-sidebar: rgba(110,231,183,0.25);
            --danger-sidebar: #f87171;
            --danger-bg-sidebar: rgba(248,113,113,0.08);

            /* ── Sidebar transition token — single source of truth ── */
            --sidebar-transition: width 0.28s cubic-bezier(0.4,0,0.2,1),
                                   transform 0.28s cubic-bezier(0.4,0,0.2,1);
        }

        .dark {
            --nav-bg:         rgba(11,17,32,0.97);
            --nav-border:     rgba(0,168,107,0.10);
            --nav-shadow:     0 1px 0 rgba(0,168,107,0.07), 0 4px 24px rgba(0,0,0,0.35);
            --text-primary:   #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted:     #64748b;
            --text-faint:     #475569;
            --surface:        rgba(30,41,59,0.6);
            --surface-hover:  rgba(0,168,107,0.08);
            --surface-active: rgba(0,168,107,0.13);
            --dd-bg:          #131e35;
            --dd-border:      rgba(100,116,139,0.13);
            --dd-shadow:      0 16px 48px rgba(0,0,0,0.45), 0 4px 12px rgba(0,0,0,0.3);
            --divider:        rgba(100,116,139,0.10);
            --jade-glow:      rgba(0,168,107,0.10);
            --danger-glow:    rgba(239,68,68,0.18);
        }

        /* ── Skip link ── */
        .skip-link {
            position: absolute; left: -9999px; top: auto;
            width: 1px; height: 1px; overflow: hidden;
        }
        .skip-link:focus {
            position: static; left: auto; top: auto;
            width: auto; height: auto; overflow: visible;
            padding: 0.5rem; background: #fff; color: #111;
            border-radius: 0.375rem;
            box-shadow: 0 0 0 3px rgba(16,185,129,0.25);
        }

        /* ── Prevent scroll on mobile sidebar open ── */
        @media (max-width: 767px) {
            body.sidebar-open { overflow: hidden; }
        }

        /*
         * ── Stacking order documentation ─────────────────────────────
         * This establishes the layering strategy for fixed elements.
         *
         * z-0   : body, content, normal flow
         * z-10  : background blobs (decorative, behind everything)
         * z-20  : scrolled content behind fixed elements (min-height: 0)
         * z-29  : sidebar mobile overlay (semi-transparent, blocks interaction)
         * z-30  : navbar (fixed on top, above overlay for toggle clickability)
         * z-40  : sidebar container (fixed, highest layer when needed)
         * z-50+ : modals, dropdowns, tooltips
         *
         * CRITICAL: On desktop, navbar sits inside .content-shift flow
         * (no fixed positioning), so z-index not needed. On mobile,
         * navbar must be z: 30 to stay clickable above overlay at z: 29.
         * ────────────────────────────────────────────────────────────── */

        /*
         * ── Content shift ────────────────────────────────────────────
         * Matches sidebar width transitions exactly. Margin-left shifts
         * between collapse/expand states using the --sidebar-transition
         * token defined in :root. Will-change enables GPU acceleration.
         *
         * Timeline: 0.28s, easing: cubic-bezier(0.4,0,0.2,1) — synced
         * with sidebar width transition to prevent visual misalignment.
         * ────────────────────────────────────────────────────────────── */
        @media (min-width: 768px) {
            .content-shift {
                transition   : margin-left 0.28s cubic-bezier(0.4,0,0.2,1);
                will-change  : margin-left;
            }
        }
        @media (max-width: 767px) {
            .content-shift { margin-left: 0; }
        }

        .app-shell {
            position: relative;
            display: flex;
            flex-direction: row;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(0, 168, 107, 0.05), transparent 28%),
                radial-gradient(circle at top right, rgba(239, 191, 4, 0.04), transparent 24%),
                #f8fafc;
            overflow: hidden;
        }

        .app-main-shell {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
            min-width: 0;
            background: transparent;
            margin-left: var(--sidebar-collapsed-width, 72px);
            transition: margin-left 0.28s cubic-bezier(0.4,0,0.2,1), padding-left 0.28s cubic-bezier(0.4,0,0.2,1);
            will-change: margin-left;
        }

        html.sidebar-open-pending .app-main-shell {
            margin-left: var(--sidebar-expanded-width, 260px);
        }

        body.sidebar-open .app-main-shell {
            margin-left: var(--sidebar-expanded-width, 260px);
        }

        main.content-surface {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: transparent;
            min-height: auto;
        }

        /* ── Grid/table sections within content ── */
        .content-grid-section {
            background: rgba(255, 255, 255, 0.88);
            border: 0.5px solid rgba(0, 103, 79, 0.08);
            border-radius: 12px;
            transition: box-shadow 0.2s ease, background 0.2s ease;
        }

        .content-grid-section:hover {
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 2px 8px rgba(0, 103, 79, 0.08);
        }

        /* ── Semantic bordered sections ── */
        .perf-strip {
            background: linear-gradient(135deg, #0f172a, #111827) !important;
            border-radius: 20px;
            color: #f8fafc;
        }

        .metric-strip {
            background: #ffffff !important;
            border-radius: 20px;
        }

        .quick-stats-bar {
            background: #ffffff !important;
            border-radius: 18px;
        }

        /* ── Chart container ── */
        .chart-container {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        }

        /* ── Side container ── */
        .side-container {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        }

        /* ── Screen-reader only ── */
        .sr-only {
            position: absolute; width: 1px; height: 1px;
            padding: 0; margin: -1px; overflow: hidden;
            clip: rect(0,0,0,0); white-space: nowrap; border: 0;
        }

        /*
         * ── Footer shift ────────────────────────────────────────────
         * Transition synced with sidebar using --sidebar-transition token
         * for pixel-perfect timing alignment. Will-change enables GPU
         * acceleration for smooth 60fps animation during collapse/expand.
         * ────────────────────────────────────────────────────────────── */
        .fixed-footer { box-shadow: 0 -1px 0 rgba(0,0,0,0.04); }
        .footer-container {
            transition: margin-left 0.28s cubic-bezier(0.4,0,0.2,1);
            will-change: margin-left;
        }

        @media (min-width: 768px) {
            .fixed-footer .footer-container {
                margin-left: var(--sidebar-collapsed-width);
            }
            body.sidebar-open .fixed-footer .footer-container {
                margin-left: var(--sidebar-expanded-width);
            }
        }
        @media (max-width: 767px) {
            .fixed-footer .footer-container { margin-left: 0; }
        }

        /* ── Misc ── */
        .mini-tooltip { position: relative; z-index: 20; transition: opacity .15s ease; }
        .card-heading i { width: 1.25rem; display: inline-block; text-align: center; }

        html { scroll-behavior: smooth; }
        body {
            color: var(--slate-700);
            background: #f8fafc;
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        }

        @media (max-width: 767px) {
            :root {
                --navbar-height: 60px;
            }
        }

        .content-surface {
            position: relative;
            z-index: 1;
        }

        /* ── Background blobs ── */
        .bg-blob {
            position: fixed; border-radius: 50%; filter: blur(100px);
            opacity: 0.05; pointer-events: none; z-index: 0;
            animation: drift 18s ease-in-out infinite alternate;
        }
        .bg-blob-1 { width:480px; height:480px; background: var(--emerald-500); top:-120px; left:-160px; animation-delay:0s; }
        .bg-blob-2 { width:320px; height:320px; background: var(--jade); bottom:-80px; right:-80px; animation-delay:-7s; }
        .bg-blob-3 { width:220px; height:220px; background: var(--gold, #EFBF04); top:40%; left:55%; animation-delay:-3.5s; opacity: 0.03; }

        @keyframes drift {
            from { transform: translate(0,0) scale(1); }
            to   { transform: translate(20px,28px) scale(1.06); }
        }
    </style>

</head>

<body class="bg-gray-100 font-sans antialiased text-slate-700">

    {# ── FOUC Prevention Script ──────────────────────────────────────── #}
    {# Optimized: Minimal inline, runs BEFORE first paint to prevent CLS #}
    {# Uses requestIdleCallback after paint to reduce blocking time        #}
    {# ────────────────────────────────────────────────────────────────── #}
    <script>
    (function(){
        if (window.innerWidth >= 768) {
            try {
                var p = localStorage.getItem('sidebarOpen');
                if (p !== 'false') {
                    /* Add class ASAP before paint */
                    document.documentElement.classList.add('sidebar-open-pending');
                }
            } catch(e) {}
        }
    })();
    </script>
    <style>
        html.sidebar-open-pending { --sidebar-width: var(--sidebar-expanded-width); }
        html:not(.sidebar-open-pending) { --sidebar-width: var(--sidebar-collapsed-width); }
        .app-main-shell { margin-left: var(--sidebar-width); }
    </style>

    <!-- Peringatan tanpa JavaScript -->
    <noscript>
        <div style="text-align:center;background:#f8d7da;color:#721c24;padding:15px;border-bottom:1px solid #f5c6cb;">
            <strong>Peringatan:</strong> Aplikasi ini memerlukan JavaScript.
        </div>
    </noscript>

    <!-- Skip link aksesibilitas -->
    <a href="#main-content" class="skip-link">Lompat ke konten</a>

    <!-- Live region untuk screen reader -->
    <div id="sr-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    <div class="app-shell flex h-screen" id="app-root">

        {% include 'base/sidebar.html' %}

        <div class="app-main-shell flex-1 flex flex-col h-screen overflow-hidden content-shift">

            {% include 'base/navbar.html' %}

            <main id="main-content"
                  role="main"
                  tabindex="-1"
                  class="content-surface w-full flex-1 overflow-x-hidden overflow-y-auto px-4 py-6 sm:px-6 lg:px-8 pb-20 md:pb-16">
                {% block content %}{% endblock %}
            </main>

        </div>

    </div>

    {% block dashboard_scripts %}{% endblock %}
    {% block scripts %}{% endblock %}

    {# ── Global Sidebar Toggle Handler (runs BEFORE Alpine.js) ─────────────── #}
    {# This ensures toggle-sidebar events work regardless of Alpine init timing #}
    <script>
    (function() {
      console.log('[Base] Setting up global sidebar toggle handler');
      
      window.toggleSidebarClass = function() {
        var body = document.body;
        var isOpen = body.classList.contains('sidebar-open');
        console.log('[Base.toggleSidebarClass] Current state:', isOpen, '→ toggling to:', !isOpen);
        
        body.classList.toggle('sidebar-open', !isOpen);
        
        // Save to localStorage
        try {
          localStorage.setItem('sidebarOpen', String(!isOpen));
        } catch(e) {}
        
        // Dispatch event for Alpine components
        window.dispatchEvent(new CustomEvent('sidebar-toggled', { detail: { open: !isOpen } }));
      };
      
      // Listen for toggle-sidebar event (from navbar)
      window.addEventListener('toggle-sidebar', function(e) {
        console.log('[Base] Global toggle-sidebar event received');
        window.toggleSidebarClass();
      });
      
      console.log('[Base] Global sidebar toggle handler ready');
    })();
    </script>

    {# ── Alpine.js Ecosystem ─────────────────────────────────────────── #}
    {# CRITICAL: Load order must be preserved:                           #}
    {#  1. Collapse plugin (registers itself to Alpine)                  #}
    {#  2. Alpine core (initializes, discovers plugins)                 #}
    {#                                                                   #}
    {# Both use defer, so they load asynchronously then execute in      #}
    {# document order. Plugin can't be after Alpine or it won't be      #}
    {# available during Alpine initialization.                         #}
    {# ──────────────────────────────────────────────────────────────── #}
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    {# ── Uncloak fallback if Alpine fails to load ── #}
    <script>
    function showIfNoAlpine() {
        if (!window.Alpine) {
            document.querySelectorAll('[x-cloak]').forEach(function(el) {
                el.removeAttribute('x-cloak');
            });
            document.querySelectorAll('.reveal').forEach(function(el) {
                el.classList.add('visible');
            });
        }
    }
    document.addEventListener('DOMContentLoaded', function() {
        showIfNoAlpine();
        setTimeout(showIfNoAlpine, 500);
    });
    window.addEventListener('error', function(e) {
        if (e.target && e.target.tagName === 'SCRIPT' &&
            e.target.src && e.target.src.includes('alpinejs')) {
            showIfNoAlpine();
        }
    }, true);
    </script>

    {# ── Accessibility: focus trap for mobile sidebar ── #}
    <script>
    (function() {
        var sr = document.getElementById('sr-announcer');
        var removeTrap = null;

        function announce(msg) {
            if (sr) sr.textContent = msg;
        }

        function enableFocusTrap(container) {
            var sel = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
            var focusable = container.querySelectorAll(sel);
            if (!focusable.length) return function() {};
            var first = focusable[0];
            var last  = focusable[focusable.length - 1];

            function handler(e) {
                if (e.key !== 'Tab') return;
                if (e.shiftKey) {
                    if (document.activeElement === first) { e.preventDefault(); last.focus(); }
                } else {
                    if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
                }
            }
            document.addEventListener('keydown', handler);
            return function() { document.removeEventListener('keydown', handler); };
        }

        var body    = document.body;
        var sidebar = document.getElementById('sidebar');

        var bodyObs = new MutationObserver(function() {
            var isOpen   = body.classList.contains('sidebar-open');
            var isMobile = window.innerWidth < 768;

            if (isOpen && isMobile && sidebar) {
                setTimeout(function() {
                    removeTrap = enableFocusTrap(sidebar);
                    announce('Sidebar terbuka');
                }, 150);
            } else {
                if (typeof removeTrap === 'function') { removeTrap(); removeTrap = null; }
                if (!isOpen && isMobile) announce('Sidebar ditutup');
            }
        });
        bodyObs.observe(body, { attributes: true, attributeFilter: ['class'] });

        window.addEventListener('resize', function() {
            if (window.innerWidth >= 768 && typeof removeTrap === 'function') {
                removeTrap(); removeTrap = null;
            }
        });
    })();
    </script>

    {% block extra_scripts %}{% endblock %}

</body>
</html>