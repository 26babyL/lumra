{# base/partials/tabs.html #}
{# Tabbed navigation component #}

<div x-data="{ activeTab: '{{ active_tab|default:'tab1' }}' }" class="mb-6">
  <!-- Tab buttons -->
  <div class="flex gap-2 border-b border-slate-700 overflow-x-auto">
    {% for tab in tabs %}
      <button
        @click="activeTab = '{{ tab.id }}'"
        :class="{
          'border-b-2 border-emerald-500 text-emerald-400 bg-slate-900/50': activeTab === '{{ tab.id }}',
          'text-slate-400 hover:text-slate-300 border-b-2 border-transparent': activeTab !== '{{ tab.id }}'
        }"
        class="px-4 py-3 font-medium transition whitespace-nowrap"
      >
        {% if tab.icon %}<i class="fas {{ tab.icon }} mr-2"></i>{% endif %}
        {{ tab.label }}
      </button>
    {% endfor %}
  </div>

  <!-- Tab content -->
  <div class="mt-6">
    {% for tab in tabs %}
      <div x-show="activeTab === '{{ tab.id }}'" x-cloak>
        {{ tab.content|safe }}
      </div>
    {% endfor %}
  </div>
</div>
