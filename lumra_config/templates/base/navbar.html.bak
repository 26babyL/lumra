<!-- navbar.html.bak -->
{% load static %}
<style>
  /* ═══════════════════════════════════════════════════════════
     LUMRA NAVBAR — v5.0 Clean Production
     ═══════════════════════════════════════════════════════════ */
  [x-cloak] { display: none !important; }

  /* ── Shell ── */
  .nav {
    background: var(--nav-bg);
    border-bottom: 0.5px solid var(--nav-border);
    height: var(--navbar-height, 60px);
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 18px;
    position: relative;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    box-shadow: var(--nav-shadow);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition:
      box-shadow 0.2s ease,
      background 0.25s ease;
    flex-shrink: 0;
    /* Ensure smooth animation when app-main-shell margin changes */
    will-change: auto;
  }

  /* Navbar positioned relative within app-main-shell */
  /* Automatically shifts when parent margin-left changes */
  /* Parent .app-main-shell handles the margin transition */
  @media (min-width: 768px) {
    .nav {
      transition: box-shadow 0.2s ease, background 0.25s ease, margin-left 0.28s cubic-bezier(0.4,0,0.2,1);
    }
  }

  /* ── Brand ── */
  .nav-brand {
    display: none;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }
  .nav-brand:hover { opacity: 0.82; }

  .nav-brand-mark {
    width: 32px; height: 32px;
    border-radius: 9px;
    background: linear-gradient(140deg, #34d399 0%, #059669 55%, #047857 100%);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(16,185,129,0.22);
    transition: transform 0.2s var(--ease), box-shadow 0.2s ease;
  }
  .nav-brand:hover .nav-brand-mark {
    transform: scale(1.06);
    box-shadow: 0 6px 18px rgba(16,185,129,0.3);
  }

  .nav-brand-text { line-height: 1; }

  .nav-brand-name {
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    display: block;
  }

  .nav-brand-version {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-transform: uppercase;
    display: block;
    margin-top: 2px;
  }

  /* ── Separator ── */
  .nav-sep {
    width: 0.5px;
    height: 18px;
    background: var(--divider);
    flex-shrink: 0;
  }

  /* ── Icon Button ── */
  .nav-btn {
    position: relative;
    width: 34px; height: 34px;
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.13s ease, color 0.13s ease, transform 0.1s ease;
    flex-shrink: 0;
    outline: none;
  }
  .nav-btn:hover  { background: var(--surface-hover); color: var(--text-primary); }
  .nav-btn:active { transform: scale(0.92); }
  .nav-btn:focus-visible { box-shadow: 0 0 0 2px var(--jade-ring); }
  .nav-btn svg { width: 17px; height: 17px; stroke-width: 1.8; display: block; }

  /* ── Dropdown base ── */
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    background: var(--dd-bg);
    border: 0.5px solid var(--dd-border);
    border-radius: 14px;
    box-shadow: var(--dd-shadow);
    z-index: 200;
    overflow: hidden;
    transform-origin: top center;
  }

  /* ── Store Pill ── */
  .store-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 11px;
    border: 0.5px solid var(--nav-border);
    border-radius: 9px;
    background: var(--surface);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    font-family: inherit;
    flex-shrink: 0;
    transition: border-color 0.15s, background 0.15s;
    outline: none;
    white-space: nowrap;
    max-width: 220px;
  }
  .store-pill:hover {
    border-color: rgba(0,168,107,0.22);
    background: var(--dd-bg);
  }
  .store-pill:focus-visible { box-shadow: 0 0 0 2px var(--jade-ring); }
  .store-pill:active { transform: scale(0.98); }

  .store-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .store-dot.online, .store-dot.live {
    background: var(--jade);
    animation: dotPulse 2.6s ease infinite;
  }
  .store-dot.warning, .store-dot.busy { background: #f59e0b; }
  .store-dot.offline { background: var(--text-muted); }

  @keyframes dotPulse {
    0%,100% { box-shadow: 0 0 0 0 var(--jade-glow); }
    50%      { box-shadow: 0 0 0 4px rgba(0,168,107,0); }
  }

  .store-pill-name {
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1; min-width: 0;
  }

  .store-pill-sep  { color: var(--text-faint); flex-shrink: 0; }

  .store-pill-city {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 11.5px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .store-pill-chevron {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s var(--ease);
    display: flex; align-items: center;
  }

  /* ── Store Dropdown ── */
  .store-dropdown { left: 0; width: 232px; }

  .dd-scroll {
    max-height: 240px;
    overflow-y: auto;
    padding: 4px 0;
  }
  .dd-scroll::-webkit-scrollbar { width: 3px; }
  .dd-scroll::-webkit-scrollbar-thumb { background: var(--text-faint); border-radius: 10px; }

  .store-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    cursor: pointer;
    transition: background 0.1s;
    border: none; border-left: 2.5px solid transparent;
    background: transparent;
    width: 100%; text-align: left;
    font-family: inherit; outline: none;
  }
  .store-item:hover { background: var(--surface-hover); }
  .store-item:focus-visible { box-shadow: inset 0 0 0 2px var(--jade-ring); }
  .store-item.active {
    background: var(--surface-active);
    border-left-color: var(--jade);
  }

  .store-item-emoji { font-size: 14px; width: 20px; text-align: center; flex-shrink: 0; }

  .store-item-info { flex: 1; min-width: 0; }

  .store-item-name {
    font-size: 12.5px; font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    margin: 0;
  }

  .store-item-city {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
  }

  .store-item-check {
    width: 14px; height: 14px;
    flex-shrink: 0;
    color: var(--jade);
    opacity: 0;
    transition: opacity 0.12s;
  }
  .store-item.active .store-item-check { opacity: 1; }

  .dd-footer {
    border-top: 0.5px solid var(--divider);
    padding: 9px 13px;
  }
  .dd-footer a {
    font-size: 12px; font-weight: 600;
    color: var(--jade);
    text-decoration: none;
    transition: opacity 0.12s;
  }
  .dd-footer a:hover { opacity: 0.7; }

  /* ── Search ── */
  .search-wrap {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
    padding: 0 10px;
  }

  .search-inner {
    position: relative;
    width: 100%;
    max-width: 520px;
  }

  .search-icon-left {
    position: absolute;
    left: 10px; top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--text-muted);
    display: flex; align-items: center;
    transition: color 0.15s;
  }

  .search-input {
    width: 100%; height: 34px;
    background: var(--surface);
    border: 0.5px solid var(--divider);
    border-radius: 9px;
    padding: 0 38px 0 33px;
    font-size: 13px; font-weight: 500;
    color: var(--text-primary);
    font-family: inherit;
    transition: background 0.18s, border-color 0.18s, box-shadow 0.18s;
    outline: none;
    caret-color: var(--jade);
  }
  .search-input:focus {
    background: var(--dd-bg);
    border-color: var(--jade-ring);
    box-shadow: 0 0 0 3px var(--jade-light);
  }
  .search-input::placeholder { color: var(--text-faint); }

  .search-input:focus ~ .search-icon-left { color: var(--jade); }

  .search-right-slot {
    position: absolute;
    right: 8px; top: 50%;
    transform: translateY(-50%);
    display: flex; align-items: center; gap: 4px;
  }

  .search-clear {
    width: 20px; height: 20px;
    border-radius: 5px;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
    background: transparent;
    border: none; cursor: pointer;
    transition: background 0.12s, color 0.12s;
    outline: none;
  }
  .search-clear:hover { background: var(--surface-hover); color: var(--text-primary); }

  .kbd {
    display: inline-flex; align-items: center;
    padding: 1px 5px;
    border: 0.5px solid var(--divider);
    border-radius: 5px;
    background: var(--surface);
    font-size: 10px; font-weight: 600;
    font-family: 'SF Mono','Fira Code',ui-monospace,monospace;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Search Dropdown ── */
  .search-dropdown { left: 0; right: 0; top: calc(100% + 6px); }

  .sec-label {
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-faint);
    padding: 10px 14px 5px;
    user-select: none;
  }

  .cmd-token {
    display: inline-flex; align-items: center;
    padding: 2px 7px; border-radius: 5px;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase;
  }
  .tok-product  { background: rgba(0,168,107,0.10); color: #065f46; }
  .tok-location { background: rgba(59,130,246,0.10); color: #1e40af; }
  .tok-stock    { background: rgba(245,158,11,0.10); color: #78350f; }
  .dark .tok-product  { background: rgba(0,168,107,0.18); color: #34d399; }
  .dark .tok-location { background: rgba(59,130,246,0.18); color: #60a5fa; }
  .dark .tok-stock    { background: rgba(245,158,11,0.18); color: #fbbf24; }

  .cmd-hint-row {
    display: flex; align-items: center; gap: 9px;
    padding: 8px 14px;
    cursor: pointer;
    transition: background 0.1s;
    border: none; background: transparent;
    width: 100%; font-family: inherit; outline: none;
  }
  .cmd-hint-row:hover { background: var(--surface-hover); }
  .cmd-hint-row:focus-visible { box-shadow: inset 0 0 0 2px var(--jade-ring); }

  .cmd-hint-desc {
    font-size: 12px; color: var(--text-muted);
    flex: 1; text-align: left;
  }

  .recent-row {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 14px;
    cursor: pointer;
    transition: background 0.1s;
    border: none; background: transparent;
    width: 100%; font-family: inherit; outline: none;
  }
  .recent-row:hover { background: var(--surface-hover); }
  .recent-row:focus-visible { box-shadow: inset 0 0 0 2px var(--jade-ring); }

  .search-result-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 14px;
    cursor: pointer;
    transition: background 0.1s;
    border: none; background: transparent;
    width: 100%; text-align: left; font-family: inherit; outline: none;
    position: relative;
  }
  .search-result-item:hover { background: var(--surface-hover); }
  .search-result-item.kb-active { background: var(--surface-active); }
  .search-result-item.kb-active::before {
    content: '';
    position: absolute; left: 0; top: 15%; bottom: 15%;
    width: 3px; border-radius: 0 3px 3px 0;
    background: var(--jade);
  }
  .search-result-item:focus-visible { box-shadow: inset 0 0 0 2px var(--jade-ring); }

  .result-type-icon {
    width: 28px; height: 28px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700; flex-shrink: 0;
  }
  .rti-product  { background: rgba(0,168,107,0.10); color: #065f46; }
  .rti-location { background: rgba(59,130,246,0.10); color: #1e40af; }
  .rti-stock    { background: rgba(245,158,11,0.10); color: #78350f; }
  .dark .rti-product  { background: rgba(0,168,107,0.18); color: #34d399; }
  .dark .rti-location { background: rgba(59,130,246,0.18); color: #60a5fa; }
  .dark .rti-stock    { background: rgba(245,158,11,0.18); color: #fbbf24; }

  .badge-pill {
    font-size: 10px; font-weight: 600;
    padding: 2px 8px; border-radius: 99px; flex-shrink: 0;
  }
  .bp-success { background: rgba(0,168,107,0.10); color: #065f46; }
  .bp-warning { background: rgba(245,158,11,0.10); color: #78350f; }
  .bp-danger  { background: rgba(239,68,68,0.10);  color: #991b1b; }
  .bp-neutral { background: var(--surface); color: var(--text-muted); border: 0.5px solid var(--divider); }
  .dark .bp-success { background: rgba(0,168,107,0.18); color: #34d399; }
  .dark .bp-warning { background: rgba(245,158,11,0.18); color: #fbbf24; }
  .dark .bp-danger  { background: rgba(239,68,68,0.18); color: #f87171; }

  .results-scroll {
    max-height: 256px; overflow-y: auto;
    padding-bottom: 4px;
  }
  .results-scroll::-webkit-scrollbar { width: 3px; }
  .results-scroll::-webkit-scrollbar-thumb { background: var(--text-faint); border-radius: 10px; }

  .search-dd-footer {
    border-top: 0.5px solid var(--divider);
    padding: 8px 14px;
    display: flex; justify-content: space-between; align-items: center;
  }

  /* ── Notification ── */
  .notif-dot {
    position: absolute; top: 6px; right: 6px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--danger);
    border: 1.5px solid var(--nav-bg);
    animation: notifPulse 2.6s ease infinite;
  }
  @keyframes notifPulse {
    0%,100% { box-shadow: 0 0 0 0 var(--danger-glow); }
    50%      { box-shadow: 0 0 0 4px rgba(239,68,68,0); }
  }

  .notif-dropdown { right: 0; width: 314px; }

  .notif-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px 0;
    border-bottom: 0.5px solid var(--divider);
  }

  .notif-title { font-size: 13px; font-weight: 700; color: var(--text-primary); }

  .notif-tab {
    padding: 5px 9px; border: none; background: transparent;
    font-size: 11px; font-weight: 600; cursor: pointer;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -0.5px;
    transition: color 0.14s, border-color 0.14s;
    font-family: inherit; outline: none;
  }
  .notif-tab:hover { color: var(--text-secondary); }
  .notif-tab.active { color: var(--jade); border-bottom-color: var(--jade); }
  .notif-tab:focus-visible { box-shadow: 0 0 0 2px var(--jade-ring); border-radius: 4px; }

  .notif-list { max-height: 274px; overflow-y: auto; }
  .notif-list::-webkit-scrollbar { width: 3px; }
  .notif-list::-webkit-scrollbar-thumb { background: var(--text-faint); border-radius: 10px; }

  .notif-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 11px 14px;
    transition: background 0.1s;
    position: relative;
    cursor: pointer;
    text-decoration: none;
  }
  .notif-item:hover { background: var(--surface-hover); }
  .notif-item.unread { background: rgba(0,168,107,0.018); }

  .notif-icon-box {
    width: 30px; height: 30px; border-radius: 8px;
    background: var(--surface);
    border: 0.5px solid var(--divider);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .notif-type-badge {
    font-size: 9px; font-weight: 700;
    padding: 1px 5px; border-radius: 4px;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ntb-stock  { background: rgba(245,158,11,0.10); color: #78350f; }
  .ntb-system { background: rgba(59,130,246,0.10);  color: #1e40af; }
  .ntb-report { background: rgba(0,168,107,0.10);   color: #065f46; }
  .ntb-alert  { background: rgba(239,68,68,0.10);   color: #991b1b; }
  .dark .ntb-stock  { background: rgba(245,158,11,0.18); color: #fbbf24; }
  .dark .ntb-system { background: rgba(59,130,246,0.18); color: #60a5fa; }
  .dark .ntb-report { background: rgba(0,168,107,0.18); color: #34d399; }
  .dark .ntb-alert  { background: rgba(239,68,68,0.18); color: #f87171; }

  .notif-unread-badge {
    position: absolute; top: 50%; right: 12px;
    transform: translateY(-50%);
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--jade); flex-shrink: 0;
  }

  /* ── Profile ── */
  .profile-trigger {
    display: flex; align-items: center; gap: 7px;
    padding: 4px 8px 4px 4px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.14s;
    border: none; background: transparent;
    font-family: inherit; outline: none;
  }
  .profile-trigger:hover { background: var(--surface); }
  .profile-trigger:focus-visible { box-shadow: 0 0 0 2px var(--jade-ring); border-radius: 10px; }

  .avatar-img {
    width: 28px; height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--divider);
    transition: border-color 0.15s, box-shadow 0.15s;
    flex-shrink: 0;
  }
  .profile-trigger:hover .avatar-img {
    border-color: var(--jade);
    box-shadow: 0 0 0 2px var(--jade-light);
  }

  .profile-dropdown { right: 0; width: 214px; }

  .profile-header-box {
    padding: 12px 14px;
    border-bottom: 0.5px solid var(--divider);
    background: var(--surface);
  }

  .profile-store-row {
    display: flex; align-items: center; gap: 6px; margin-bottom: 3px;
  }

  .profile-menu-item {
    display: flex; align-items: center; gap: 9px;
    padding: 9px 14px;
    font-size: 12.5px;
    color: var(--text-secondary);
    transition: background 0.12s, color 0.12s;
    cursor: pointer;
    text-decoration: none;
    border: none; background: transparent;
    width: 100%; text-align: left; font-family: inherit; outline: none;
  }
  .profile-menu-item:hover { background: var(--surface-hover); color: var(--text-primary); }
  .profile-menu-item:focus-visible { box-shadow: inset 0 0 0 2px var(--jade-ring); }
  .profile-menu-item svg { width: 15px; height: 15px; flex-shrink: 0; color: var(--text-muted); transition: color 0.12s; }
  .profile-menu-item:hover svg { color: var(--text-secondary); }

  .profile-menu-item.danger { color: #ef4444; }
  .profile-menu-item.danger:hover { background: rgba(239,68,68,0.06); color: #dc2626; }
  .profile-menu-item.danger svg { color: #ef4444; }
  .dark .profile-menu-item.danger { color: #f87171; }

  /* ── Transitions for Alpine ── */
  [x-transition\:enter]                { transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }
  [x-transition\:enter-start]          { opacity: 0; transform: scale(0.97) translateY(-4px); }
  [x-transition\:enter-end]            { opacity: 1; transform: scale(1) translateY(0); }
  [x-transition\:leave]                { transition: opacity 0.14s ease, transform 0.14s ease; }
  [x-transition\:leave-end]            { opacity: 0; transform: scale(0.97) translateY(-4px); }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nav { padding: 0 12px; gap: 8px; }
    body.sidebar-open .nav { padding-left: 12px; }
    .store-pill { max-width: 160px; }
    .store-pill-city, .store-pill-sep { display: none; }
    .notif-dropdown { width: min(314px, calc(100vw - 24px)); }
    .profile-dropdown { width: min(214px, calc(100vw - 24px)); }
  }

  @media (max-width: 560px) {
    .nav-brand-text { display: none; }
    .search-wrap { padding: 0 6px; }
    .store-pill { max-width: 140px; padding: 0 9px; font-size: 12px; }
  }
</style>

<!--
  LUMRA NAVBAR — v5.0
  ─────────────────────────────────────────────
  Improvements from v4.0:
  • Thinner 0.5px borders everywhere (crisper)
  • Backdrop-filter blur on nav glass effect
  • Store pill city hidden on mobile, sep too
  • parsedCmd & resultsLabel as computed getters
  • Keyboard nav (↑↓ Enter Escape /) fully wired
  • Token width measured reactively via $refs
  • notifCount fed from Django context
  • switchStore calls CSRF-protected endpoint
  • toggleTheme() writes to <html> class + storage
  • All focus-visible rings for a11y
  • No duplicate navApp() declarations
  ─────────────────────────────────────────────
-->
<header
  class="nav"
  x-data="navApp()"
  x-init="init()"
  x-cloak>

  <!-- ░░ LEFT ░░ -->
  <div class="flex items-center gap-3 flex-shrink-0">

    <!-- Brand -->
    <a href="{% url 'dashboard' %}" class="nav-brand" aria-label="Lumra — kembali ke dasbor">
      <span class="nav-brand-mark" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 4h3v12h6.5V19H7V4z"/>
        </svg>
      </span>
      <span class="nav-brand-text">
        <span class="nav-brand-name">Lumra</span>
        <span class="nav-brand-version">Versi 3</span>
      </span>
    </a>

    <!-- Sidebar Toggle Button -->
    <button
      class="nav-btn"
      @click="toggleSidebar()"
      aria-label="Toggle sidebar"
      title="Toggle sidebar (Ctrl+B)">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>

    <span class="nav-sep"></span>

    <!-- Store Pill -->
    <div class="relative flex-shrink-0" @click.outside="storeOpen = false">
      <button
        class="store-pill"
        @click="storeOpen = !storeOpen"
        :aria-expanded="storeOpen.toString()"
        aria-haspopup="listbox"
        aria-label="Ganti cabang">
        <span class="store-dot" :class="activeStore.status || 'online'"></span>
        <span class="store-pill-name" x-text="activeStore.name"></span>
        <span class="store-pill-sep" x-show="activeStore.city" aria-hidden="true">·</span>
        <span class="store-pill-city" x-show="activeStore.city" x-text="activeStore.city"></span>
        <span class="store-pill-chevron" aria-hidden="true"
              :style="storeOpen ? 'transform:rotate(180deg)' : ''">
          <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </span>
      </button>

      <!-- Store Dropdown -->
      <div
        x-show="storeOpen"
        x-transition:enter x-transition:enter-start x-transition:enter-end
        x-transition:leave x-transition:leave-end
        class="nav-dropdown store-dropdown"
        role="listbox"
        :aria-label="'Pilih cabang, aktif: ' + activeStore.name">

        <div class="dd-scroll">
          <template x-for="store in stores" :key="store.id">
            <button
              class="store-item"
              :class="store.id === activeStore.id ? 'active' : ''"
              @click="switchStore(store, $event)"
              role="option"
              :aria-selected="store.id === activeStore.id">
              <span class="store-item-emoji" x-text="store.emoji || '🏪'" aria-hidden="true"></span>
              <div class="store-item-info">
                <p class="store-item-name" x-text="store.name"></p>
                <p class="store-item-city" x-text="store.city || ''"></p>
              </div>
              <svg class="store-item-check" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </button>
          </template>
        </div>

        <div class="dd-footer">
          <a href="{% url 'locations' %}">Kelola Cabang →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ░░ CENTER — Search ░░ -->
  <div class="search-wrap" @click.outside="closeSearch()">
    <div class="search-inner">

      <!-- Left icon (reacts to focus state) -->
      <span class="search-icon-left" aria-hidden="true"
            :style="searchFocused ? 'color:var(--jade)' : ''">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </span>

      <!-- Command-prefix token overlay -->
      <div x-show="parsedCmd.prefix"
           style="position:absolute;left:33px;top:50%;transform:translateY(-50%);z-index:5;pointer-events:none;">
        <span class="cmd-token" :class="'tok-'+parsedCmd.type" x-ref="tokenEl" x-text="parsedCmd.label"></span>
      </div>

      <input
        id="nav-search"
        type="text"
        x-model="query"
        :placeholder="searchFocused ? '' : placeholders[hintIdx]"
        @focus="onSearchFocus()"
        @blur="searchFocused = false"
        @input="onInput()"
        @keydown.escape.prevent="closeSearch()"
        @keydown.arrow-down.prevent="kbMove(1)"
        @keydown.arrow-up.prevent="kbMove(-1)"
        @keydown.enter.prevent="onEnter()"
        @keydown.slash.prevent.window="focusSearch()"
        @keydown.meta.k.prevent.window="focusSearch()"
        @keydown.ctrl.k.prevent.window="focusSearch()"
        autocomplete="off"
        spellcheck="false"
        class="search-input"
        :style="parsedCmd.prefix && tokenW > 0
          ? 'padding-left:calc(2.1rem + ' + tokenW + 'px + 8px)'
          : 'padding-left:2.1rem'"
        aria-label="Cari produk, lokasi, atau stok"
        role="combobox"
        :aria-expanded="showDropdown && (results.length > 0 || !query)"
        aria-controls="search-listbox"
        aria-autocomplete="list">

      <!-- Right slot: clear btn or kbd hint -->
      <div class="search-right-slot">
        <button x-show="query.length > 0"
                @click="clearSearch()"
                class="search-clear"
                aria-label="Hapus pencarian">
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <span x-show="!query && !searchFocused" class="kbd" aria-hidden="true">/</span>
        <span x-show="!query && searchFocused"  class="kbd" style="font-size:9px;" aria-hidden="true">ESC</span>
      </div>

      <!-- Search Dropdown -->
      <div
        x-show="showDropdown"
        x-transition:enter x-transition:enter-start x-transition:enter-end
        x-transition:leave x-transition:leave-end
        class="nav-dropdown search-dropdown"
        id="search-listbox"
        role="listbox">

        <!-- Idle: hints + recent -->
        <template x-if="!query && searchFocused">
          <div>
            <p class="sec-label">Shortcut Pencarian</p>
            <div style="padding:3px 6px 8px;">
              <template x-for="h in cmdHints" :key="h.prefix">
                <button
                  class="cmd-hint-row"
                  @click="setQuery(h.prefix + ' ')">
                  <span class="cmd-token" :class="'tok-'+h.type" x-text="h.label"></span>
                  <span class="cmd-hint-desc" x-text="h.desc"></span>
                  <span class="kbd" style="font-size:9px;" x-text="h.prefix"></span>
                </button>
              </template>
            </div>

            <template x-if="recent.length > 0">
              <div>
                <p class="sec-label" style="border-top:0.5px solid var(--divider);padding-top:10px;">Terakhir Dicari</p>
                <template x-for="r in recent" :key="r">
                  <button class="recent-row" @click="setQuery(r)">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--text-faint);flex-shrink:0;">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span style="font-size:12.5px;color:var(--text-secondary);" x-text="r"></span>
                  </button>
                </template>
              </div>
            </template>
          </div>
        </template>

        <!-- Loading -->
        <template x-if="loading && query">
          <div style="display:flex;align-items:center;gap:10px;padding:16px 14px;">
            <svg style="width:15px;height:15px;color:var(--jade);" class="animate-spin" fill="none" viewBox="0 0 24 24">
              <circle style="opacity:.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path style="opacity:.75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <span style="font-size:13px;color:var(--text-muted);">Mencari…</span>
          </div>
        </template>

        <!-- Results -->
        <template x-if="!loading && results.length > 0 && query">
          <div>
            <p class="sec-label" x-text="resultsLabel"></p>
            <div class="results-scroll">
              <template x-for="(item, idx) in results" :key="item.id">
                <button
                  class="search-result-item"
                  :class="idx === kbIdx ? 'kb-active' : ''"
                  @click="selectResult(item)"
                  role="option"
                  :aria-selected="idx === kbIdx">
                  <div class="result-type-icon" :class="'rti-'+item.type"
                       x-text="item.type==='product'?'P':item.type==='location'?'L':'S'"
                       aria-hidden="true"></div>
                  <div style="flex:1;min-width:0;text-align:left;">
                    <p style="font-size:13px;font-weight:500;color:var(--text-primary);margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" x-text="item.name"></p>
                    <p style="font-size:11px;color:var(--text-muted);margin:0;" x-text="item.subtitle"></p>
                  </div>
                  <span x-show="item.badge" class="badge-pill" :class="item.badgeClass" x-text="item.badge"></span>
                </button>
              </template>
            </div>
            <div class="search-dd-footer">
              <span style="font-size:11px;color:var(--text-muted);" x-text="results.length + ' hasil'"></span>
              <span style="font-size:11px;color:var(--text-muted);display:flex;align-items:center;gap:4px;">
                <span class="kbd">↵</span> lihat semua
              </span>
            </div>
          </div>
        </template>

        <!-- Empty -->
        <template x-if="!loading && results.length === 0 && query.length > 1">
          <div style="padding:32px 14px;text-align:center;">
            <svg style="width:26px;height:26px;color:var(--text-faint);margin:0 auto 10px;display:block;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <p style="font-size:13px;font-weight:500;color:var(--text-secondary);margin:0 0 4px;">
              Tidak ada hasil untuk "<span style="color:var(--text-primary);" x-text="parsedCmd.term || query"></span>"
            </p>
            <p x-show="!parsedCmd.prefix" style="font-size:11px;color:var(--text-faint);margin:0;">
              Coba prefix:
              <span class="kbd" style="font-size:9px;">P:</span>
              <span class="kbd" style="font-size:9px;">L:</span>
              <span class="kbd" style="font-size:9px;">S:</span>
            </p>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- ░░ RIGHT ░░ -->
  <div style="display:flex;align-items:center;gap:4px;flex-shrink:0;margin-left:auto;">

    <!-- Notifications -->
    <div class="relative" @click.outside="notifOpen = false">
      <button
        class="nav-btn"
        @click="notifOpen = !notifOpen"
        :aria-expanded="notifOpen.toString()"
        aria-haspopup="true"
        aria-label="Notifikasi">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 00-5-5.917V4a1 1 0 00-2 0v1.083A6 6 0 006 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <span x-show="notifCount > 0" class="notif-dot" aria-label="Ada notifikasi belum dibaca"></span>
      </button>

      <div
        x-show="notifOpen"
        x-transition:enter x-transition:enter-start x-transition:enter-end
        x-transition:leave x-transition:leave-end
        class="nav-dropdown notif-dropdown">

        <div class="notif-header">
          <span class="notif-title">Notifikasi</span>
          <div style="display:flex;gap:2px;" role="tablist">
            <template x-for="tab in notifTabs" :key="tab.key">
              <button
                class="notif-tab"
                :class="activeNotifTab === tab.key ? 'active' : ''"
                @click="activeNotifTab = tab.key"
                role="tab"
                :aria-selected="activeNotifTab === tab.key"
                x-text="tab.label"></button>
            </template>
          </div>
        </div>

        <div class="notif-list" role="tabpanel">
          <template x-for="n in filteredNotifs" :key="n.id">
            <a :href="n.url || '#'" class="notif-item" :class="n.read ? '' : 'unread'" style="color:inherit;">
              <div class="notif-icon-box">
                <svg style="width:14px;height:14px;color:var(--text-muted);" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" :d="notifIconPath(n.type)"/>
                </svg>
              </div>
              <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                  <span class="notif-type-badge" :class="'ntb-'+n.type" x-text="notifLabel(n.type)"></span>
                  <span style="font-size:10px;color:var(--text-faint);" x-text="n.time"></span>
                </div>
                <p style="font-size:12px;color:var(--text-primary);margin:0;line-height:1.45;" x-text="n.message"></p>
              </div>
              <span x-show="!n.read" class="notif-unread-badge" aria-hidden="true"></span>
            </a>
          </template>

          <template x-if="filteredNotifs.length === 0">
            <div style="padding:32px 14px;text-align:center;">
              <svg style="width:26px;height:26px;color:var(--text-faint);margin:0 auto 8px;display:block;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 00-5-5.917V4a1 1 0 00-2 0v1.083A6 6 0 006 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
              <p style="font-size:12px;color:var(--text-muted);margin:0;">Tidak ada notifikasi</p>
            </div>
          </template>
        </div>

        <div class="dd-footer">
          <a href="{% url 'notifications' %}">Lihat semua →</a>
        </div>
      </div>
    </div>

    <span class="nav-sep"></span>

    <!-- Profile -->
    <div class="relative" @click.outside="profileOpen = false">
      <button
        class="profile-trigger"
        @click="profileOpen = !profileOpen"
        :aria-expanded="profileOpen.toString()"
        aria-haspopup="true">
        <img
          class="avatar-img"
          src="{{ user.profile.avatar.url|default:'/static/img/default-avatar.png' }}"
          alt="{{ user.get_full_name|default:user.username }}"
          loading="lazy"
          onerror="this.src='/static/img/default-avatar.png'">
        <div class="hidden md:block" style="text-align:left;line-height:1;">
          <p style="font-size:12.5px;font-weight:600;color:var(--text-primary);margin:0;white-space:nowrap;">{{ user.get_full_name|default:user.username }}</p>
          <p style="font-size:10px;color:var(--text-muted);margin:2px 0 0;white-space:nowrap;">{{ user.profile.role|default:"User" }}</p>
        </div>
        <svg class="hidden md:block"
             style="width:11px;height:11px;color:var(--text-faint);transition:transform 0.2s var(--ease);"
             :style="profileOpen ? 'transform:rotate(180deg)' : ''"
             fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
             aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <div
        x-show="profileOpen"
        x-transition:enter x-transition:enter-start x-transition:enter-end
        x-transition:leave x-transition:leave-end
        class="nav-dropdown profile-dropdown">

        <!-- Header -->
        <div class="profile-header-box">
          <div class="profile-store-row">
            <span class="store-dot" :class="activeStore.status || 'online'" style="width:6px;height:6px;animation:none;"></span>
            <span style="font-size:12px;font-weight:600;color:var(--text-primary);" x-text="activeStore.name"></span>
          </div>
          <p style="font-size:11px;color:var(--text-muted);margin:0;">{{ user.email }}</p>
        </div>

        <!-- Menu -->
        <div style="padding:4px 0;">
          <a href="{% url 'profile' %}" class="profile-menu-item">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Profil Saya
          </a>
          <a href="{% url 'settings' %}" class="profile-menu-item">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Pengaturan
          </a>
          <button @click="toggleTheme()" class="profile-menu-item">
            <template x-if="theme === 'light'">
              <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            </template>
            <template x-if="theme === 'dark'">
              <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="color:#fbbf24;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
            </template>
            <span x-text="theme === 'dark' ? 'Mode Terang' : 'Mode Gelap'"></span>
          </button>
        </div>

        <div style="border-top:0.5px solid var(--divider);padding:4px 0;">
          <a href="{% url 'logout' %}" class="profile-menu-item danger">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Keluar
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
function navApp() {
  return {

    /* ═══ STATE ═══ */
    theme:          localStorage.getItem('lumra_theme') || 'light',
    storeOpen:      false,
    notifOpen:      false,
    profileOpen:    false,
    searchFocused:  false,
    showDropdown:   false,
    query:          '',
    results:        [],
    kbIdx:          -1,
    loading:        false,
    tokenW:         0,
    _debounce:      null,
    _hintTimer:     null,

    placeholders: [
      'Cari produk, lokasi, stok…',
      'Ketik P: untuk cari produk…',
      'Ketik L: untuk cari lokasi…',
      'Ketik S: untuk cek stok…',
    ],
    hintIdx: 0,

    recent: (() => {
      try { return JSON.parse(localStorage.getItem('lumra_recent') || '[]').slice(0,5); }
      catch { return []; }
    })(),

    cmdHints: [
      { prefix:'P:', type:'product',  label:'Produk', desc:'Cari nama produk atau SKU' },
      { prefix:'L:', type:'location', label:'Lokasi', desc:'Filter cabang atau kota'   },
      { prefix:'S:', type:'stock',    label:'Stok',   desc:'Lihat produk stok rendah'  },
    ],

    notifTabs: [
      { key:'all',    label:'Semua'   },
      { key:'stock',  label:'Stok'    },
      { key:'alert',  label:'Alert'   },
      { key:'report', label:'Laporan' },
    ],
    activeNotifTab: 'all',
    notifCount: {{ notifications_count|default:0 }},

    notifications: [
      { id:1, type:'stock',  message:'Kopi Mandheling stok di bawah batas minimum (12 Kg)', time:'5 mnt',  read:false, url:'/products/2/' },
      { id:2, type:'alert',  message:'Gayo Natural Process habis di Toko Utama',             time:'23 mnt', read:false, url:'/products/3/' },
      { id:3, type:'report', message:'Laporan penjualan harian sudah siap',                  time:'1 jam',  read:true,  url:'/reports/sales/' },
      { id:4, type:'system', message:'Sinkronisasi data selesai — semua cabang terhubung',   time:'2 jam',  read:true,  url:'#' },
      { id:5, type:'stock',  message:'Kopi Luwak Toraja mendekati batas kritis (5 Kg)',      time:'3 jam',  read:true,  url:'/products/5/' },
    ],

    activeStore: {{ active_store|default:'{"id":1,"name":"Toko Utama","city":"Jakarta","status":"online","emoji":"🏪"}'|safe }},
    stores:      {{ stores_json|default:'[{"id":1,"name":"Toko Utama","city":"Jakarta","status":"live","emoji":"🏪"},{"id":2,"name":"Cabang Bandung","city":"Bandung","status":"busy","emoji":"🏬"},{"id":3,"name":"Cabang Surabaya","city":"Surabaya","status":"offline","emoji":"🏪"}]'|safe }},

    /* ═══ COMPUTED ═══ */
    get parsedCmd() {
      const q = this.query.trim();
      const map = { 'P:': ['product','Produk'], 'L:': ['location','Lokasi'], 'S:': ['stock','Stok'] };
      for (const [pfx,[type,label]] of Object.entries(map)) {
        if (q.toUpperCase().startsWith(pfx)) {
          return { prefix:true, type, label, term: q.slice(2).trim() };
        }
      }
      return { prefix:false, type:null, label:null, term:q };
    },

    get resultsLabel() {
      return { product:'Produk', location:'Lokasi', stock:'Stok Rendah' }[this.parsedCmd.type] || 'Hasil';
    },

    get filteredNotifs() {
      return this.activeNotifTab === 'all'
        ? this.notifications
        : this.notifications.filter(n => n.type === this.activeNotifTab);
    },

    /* ═══ LIFECYCLE ═══ */
    init() {
      // Apply saved theme
      if (this.theme === 'dark') document.documentElement.classList.add('dark');

      // Rotate placeholder hints
      this._hintTimer = setInterval(() => {
        this.hintIdx = (this.hintIdx + 1) % this.placeholders.length;
      }, 3500);

      // Measure token width reactively
      this.$watch('parsedCmd', () => {
        this.$nextTick(() => {
          this.tokenW = this.$refs.tokenEl ? this.$refs.tokenEl.offsetWidth : 0;
        });
      });

      // Accept store changes from outside
      window.addEventListener('lumra:store-changed', e => {
        if (e.detail?.store) this.activeStore = e.detail.store;
      });

      // Global Ctrl+B / Cmd+B for sidebar toggle
      window.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('toggle-sidebar'));
        }
      });
    },

    toggleSidebar() {
      console.log('[Navbar] toggleSidebar() called');
      
      // Primary: Try direct Alpine state toggle first
      // Alpine stores component data on the element itself
      const sidebarEl = document.getElementById('sidebar');
      
      if (sidebarEl && sidebarEl.__x) {
        // Element has Alpine component attached
        console.log('[Navbar] Found Alpine component on sidebar element');
        const component = sidebarEl.__x[0];
        if (component && component.$data && component.$data.open !== undefined) {
          console.log('[Navbar] Toggling Alpine sidebar state via $data');
          component.$data.open = !component.$data.open;
          return;
        }
      }
      
      // Fallback 1: Use global toggle function (set up in base.html)
      if (window.toggleSidebarClass) {
        console.log('[Navbar] Using global toggleSidebarClass fallback');
        window.toggleSidebarClass();
        return;
      }
      
      // Fallback 2: Dispatch event (will be caught by sidebar)
      console.log('[Navbar] Dispatching custom toggle-sidebar event');
      window.dispatchEvent(new CustomEvent('toggle-sidebar', { 
        bubbles: true, 
        composed: true 
      }));
    },

    /* ═══ SEARCH ═══ */
    focusSearch() {
      const el = document.getElementById('nav-search');
      if (el) { el.focus(); el.select(); }
    },

    onSearchFocus() {
      this.searchFocused = true;
      this.showDropdown  = true;
    },

    closeSearch() {
      this.searchFocused = false;
      this.showDropdown  = false;
      this.kbIdx = -1;
    },

    clearSearch() {
      this.query   = '';
      this.results = [];
      this.kbIdx   = -1;
      this.tokenW  = 0;
      this.$nextTick(() => document.getElementById('nav-search')?.focus());
    },

    setQuery(val) {
      this.query = val;
      this.$nextTick(() => {
        const el = document.getElementById('nav-search');
        if (el) { el.focus(); el.setSelectionRange(val.length, val.length); }
      });
      this.onInput();
    },

    onInput() {
      this.showDropdown = true;
      this.kbIdx = -1;
      clearTimeout(this._debounce);
      const term = this.parsedCmd.term;
      if (!term) { this.results = []; this.loading = false; return; }
      this.loading = true;
      this._debounce = setTimeout(() => this._runSearch(), 260);
    },

    async _runSearch() {
      const { term, type } = this.parsedCmd;
      if (!term) { this.loading = false; return; }

      // ─── Replace this block with a real fetch to your Django API ───
      // const res  = await fetch(`/api/search/?q=${encodeURIComponent(term)}&type=${type || ''}`);
      // const data = await res.json();
      // this.results = data.results;
      // ──────────────────────────────────────────────────────────────

      // Mock data (remove when API is ready)
      await new Promise(r => setTimeout(r, 160));
      const mock = {
        product: [
          { id:1, name:'Kopi Gayo Arabica',   subtitle:'SKU: KGA-001 · Stok: 240 Kg', badge:'Tersedia', badgeClass:'bp-success', type:'product', url:'/products/1/' },
          { id:2, name:'Kopi Mandheling',      subtitle:'SKU: KMN-004 · Stok: 12 Kg',  badge:'Terbatas', badgeClass:'bp-warning', type:'product', url:'/products/2/' },
          { id:3, name:'Gayo Natural Process', subtitle:'SKU: GNP-007 · Stok: 0',      badge:'Habis',    badgeClass:'bp-danger',  type:'product', url:'/products/3/' },
          { id:4, name:'Kopi Toraja Kalosi',   subtitle:'SKU: KTR-002 · Stok: 88 Kg',  badge:'Tersedia', badgeClass:'bp-success', type:'product', url:'/products/4/' },
        ],
        location: [
          { id:10, name:'Jakarta Pusat', subtitle:'12 cabang aktif', badge:'12 Cabang', badgeClass:'bp-neutral', type:'location', url:'/locations/jkt/' },
          { id:11, name:'Bandung',       subtitle:'4 cabang aktif',  badge:'4 Cabang',  badgeClass:'bp-neutral', type:'location', url:'/locations/bdg/' },
        ],
        stock: [
          { id:20, name:'Kopi Mandheling',      subtitle:'Stok 12 Kg — di bawah threshold', badge:'< 20 Kg', badgeClass:'bp-warning', type:'stock', url:'/products/2/' },
          { id:21, name:'Gayo Natural Process', subtitle:'Stok 0 — habis',                  badge:'Habis',   badgeClass:'bp-danger',  type:'stock', url:'/products/3/' },
        ],
      };
      const pool = type ? (mock[type] || []) : [...mock.product, ...mock.location, ...mock.stock];
      const q    = term.toLowerCase();
      this.results = pool.filter(p =>
        p.name.toLowerCase().includes(q) || p.subtitle.toLowerCase().includes(q)
      );
      this.loading = false;
    },

    kbMove(dir) {
      const len = this.results.length;
      if (!len) return;
      this.kbIdx = (this.kbIdx + dir + len) % len;
    },

    onEnter() {
      const hit = this.results[this.kbIdx];
      if (hit) {
        this.selectResult(hit);
      } else {
        this._saveRecent(this.query);
        window.location.href = '/search/?q=' + encodeURIComponent(this.query);
      }
    },

    selectResult(item) {
      this._saveRecent(this.query);
      this.closeSearch();
      if (item.url) window.location.href = item.url;
    },

    _saveRecent(q) {
      if (!q.trim()) return;
      const list = [q, ...this.recent.filter(r => r !== q)].slice(0,5);
      this.recent = list;
      try { localStorage.setItem('lumra_recent', JSON.stringify(list)); } catch {}
    },

    /* ═══ STORE ═══ */
    switchStore(store, evt) {
      evt?.stopPropagation();
      this.activeStore = store;
      this.storeOpen   = false;
      window.dispatchEvent(new CustomEvent('lumra:store-changed', { detail:{ store } }));
      fetch('/api/switch-store/', {
        method:  'POST',
        headers: { 'Content-Type':'application/json', 'X-CSRFToken': this._csrf() },
        body:    JSON.stringify({ store_id: store.id }),
      })
        .then(r => { if (r.ok) location.reload(); })
        .catch(()  => location.reload());
    },

    /* ═══ THEME ═══ */
    toggleTheme() {
      this.theme = this.theme === 'light' ? 'dark' : 'light';
      document.documentElement.classList.toggle('dark', this.theme === 'dark');
      try { localStorage.setItem('lumra_theme', this.theme); } catch {}
      this.profileOpen = false;
    },

    /* ═══ HELPERS ═══ */
    notifIconPath(type) {
      return {
        stock:  'M20 7l-8-4-8 4m16 0v10l-8 4m0-14L4 17m8-10v14',
        alert:  'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
        report: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
        system: 'M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18',
      }[type] || 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z';
    },

    notifLabel(type) {
      return { stock:'Stok', system:'Sistem', report:'Laporan', alert:'Alert' }[type] || 'Info';
    },

    _csrf() {
      const m = document.cookie.split(';').find(c => c.trim().startsWith('csrftoken='));
      return m ? m.trim().split('=')[1] : '';
    },

  };
}
</script>