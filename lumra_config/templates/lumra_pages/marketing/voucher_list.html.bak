{% extends 'base/base.html' %}

{% block title %}Voucher — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  [x-cloak] { display: none !important; }

  .stat-card {
    background     : var(--color-surface-mid);
    backdrop-filter: var(--glass-blur);
    border         : 1px solid rgba(255, 255, 255, 0.85);
    border-radius  : 16px;
    box-shadow     : 0 2px 10px var(--color-black-a005);
    padding        : 16px 20px;
    transition     : box-shadow .2s, transform .2s;
  }
  .stat-card:hover { box-shadow: 0 6px 20px var(--color-black-a009); transform: translateY(-1px); }
  .stat-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;
  }

  .filter-tab {
    padding: 5px 14px; border-radius: 8px; font-size: 11px; font-weight: 600;
    color: #999; background: transparent; cursor: pointer; white-space: nowrap;
    transition: background .12s, color .12s; border: none;
  }
  .filter-tab:hover { background: var(--color-emerald-600-a08); color: #003D2F; }
  .filter-tab.active { background: var(--color-emerald-600-a12); color: var(--color-primary); }

  .search-input {
    background: rgba(255,255,255,0.85); border: 1px solid rgba(203,213,225,0.5);
    border-radius: 10px; transition: background .15s, border-color .15s, box-shadow .15s;
  }
  .search-input:focus {
    background: #FFF; border-color: var(--color-emerald-600-a08);
    box-shadow: 0 0 0 3px var(--color-emerald-600-a08); outline: none;
  }

  /* ── Voucher Card ── */
  .voucher-card {
    background     : var(--color-surface-mid);
    backdrop-filter: var(--glass-blur) saturate(150%);
    border         : 1px solid rgba(255, 255, 255, 0.95);
    border-radius  : 16px;
    box-shadow     : 0 1px 6px var(--color-black-a004);
    padding        : 18px 20px;
    transition     : box-shadow .18s, transform .18s, border-color .18s;
  }
  .voucher-card:hover {
    box-shadow: 0 4px 16px var(--color-black-a008);
    transform: translateY(-1px);
    border-color: var(--color-emerald-600-a03);
  }
  .voucher-card.status-expired { opacity: .6; }
  .voucher-card.status-expired:hover { opacity: .8; }

  .voucher-stripe {
    position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 16px 0 0 16px;
  }

  /* ── Progress bar ── */
  .usage-bar-track {
    height: 6px; border-radius: 3px; background: #F1F5F9; overflow: hidden;
  }
  .usage-bar-fill {
    height: 100%; border-radius: 3px; transition: width .4s ease;
  }

  /* ── Badge ── */
  .status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 8px; border-radius: 6px;
    font-size: 10px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
  }
  .badge-active  { background: rgba(5,150,105,0.1); color: #059669; }
  .badge-expired { background: #FEF2F2; color: #DC2626; }
  .badge-draft   { background: #F1F5F9; color: #64748B; }
  .badge-upcoming{ background: #EFF6FF; color: #2563EB; }
  .badge-pct     { background: rgba(5,150,105,0.1); color: #059669; }
  .badge-fixed   { background: #EFF6FF; color: #2563EB; }

  /* ── Icon button ── */
  .icon-btn {
    width: 30px; height: 30px; border-radius: 8px; border: none; background: transparent;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .15s; color: #94A3B8; font-size: 11px;
  }
  .icon-btn:hover { background: #F1F5F9; color: #334155; }
  .icon-btn.danger:hover { background: #FEF2F2; color: #DC2626; }

  /* ── Empty ── */
  @keyframes breathe { 0%,100%{opacity:.4;transform:scale(1);} 50%{opacity:.7;transform:scale(1.05);} }
  .empty-icon { animation: breathe 3s ease-in-out infinite; }

  /* ── Skeleton ── */
  @keyframes shimmer { 0%,100%{opacity:.5;} 50%{opacity:1;} }
  .skeleton-line { animation: shimmer 1.4s infinite; background: #F1F5F9; border-radius: 6px; }

  /* ── Modal ── */
  @keyframes modalIn { from{opacity:0;transform:scale(.93) translateY(10px);} to{opacity:1;transform:none;} }
  .modal-box { animation: modalIn .22s cubic-bezier(.4,0,.2,1); }

  /* ── Confirm bar ── */
  @keyframes bulkIn { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }
  .bulk-bar { animation: bulkIn .2s ease; }
</style>
{% endblock %}

{% block content %}
<div class="bg-blob bg-blob-1" aria-hidden="true"></div>
<div class="bg-blob bg-blob-2" aria-hidden="true"></div>

<div class="w-full flex-1 space-y-5 relative z-10"
     x-data="voucherListApp()"
     x-init="init()"
     x-cloak>

  {# ── HEADER ── #}
  <div class="reveal flex items-end justify-between gap-3">
    <div>
      <nav class="flex items-center gap-2 text-xs mb-1" style="color:var(--color-emerald-600);" aria-label="Breadcrumb">
        <a href="{% url 'dashboard' %}" class="hover:text-slate-700 transition-colors">Dashboard</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-600 font-medium">Voucher</span>
      </nav>
      <h1 class="text-2xl font-bold text-slate-800">Voucher & Promo</h1>
      <p class="text-sm text-slate-400 mt-0.5">Kelola dan pantau semua voucher diskon</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="{% url 'promotion_calendar' %}"
         class="inline-flex items-center gap-2 px-3.5 py-2.5 text-xs font-semibold rounded-xl border border-slate-200 text-slate-600 hover:border-emerald-400 hover:text-emerald-600 transition-all bg-white/50">
        <i class="fas fa-calendar-alt"></i> Kalender Promo
      </a>
      <a href="{% url 'create_voucher' %}"
         class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white rounded-xl transition-all"
         style="background:var(--color-emerald-600); box-shadow:0 4px 14px rgba(5,150,105,0.25);"
         onmouseover="this.style.background='#047857'" onmouseout="this.style.background='var(--color-emerald-600)'">
        <i class="fas fa-plus text-xs"></i> Buat Voucher
      </a>
    </div>
  </div>

  {# ── STAT CARDS ── #}
  <div class="reveal grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon" style="background:var(--color-emerald-600-a08); color:var(--color-emerald-600);"><i class="fas fa-ticket-alt"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Total</p>
        <p class="text-xl font-bold text-slate-800" x-text="vouchers.length"></p>
      </div>
    </div>
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon bg-emerald-50 text-emerald-500"><i class="fas fa-check-circle"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Aktif</p>
        <p class="text-xl font-bold text-emerald-600" x-text="activeCount"></p>
      </div>
    </div>
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon bg-rose-50 text-rose-500"><i class="fas fa-clock"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Expired</p>
        <p class="text-xl font-bold text-rose-500" x-text="expiredCount"></p>
      </div>
    </div>
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon bg-blue-50 text-blue-500"><i class="fas fa-hand-holding-usd"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Total Terpakai</p>
        <p class="text-xl font-bold text-slate-800" x-text="totalUsedCount"></p>
      </div>
    </div>
  </div>

  {# ── TOOLBAR ── #}
  <div class="reveal glass-card px-4 py-3">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-0.5 flex-wrap">
        <button @click="statusFilter=''" class="filter-tab" :class="statusFilter==='' ? 'active' : ''">Semua</button>
        <button @click="statusFilter='active'" class="filter-tab" :class="statusFilter==='active' ? 'active' : ''">Aktif</button>
        <button @click="statusFilter='upcoming'" class="filter-tab" :class="statusFilter==='upcoming' ? 'active' : ''">Akan Datang</button>
        <button @click="statusFilter='draft'" class="filter-tab" :class="statusFilter==='draft' ? 'active' : ''">Draft</button>
        <button @click="statusFilter='expired'" class="filter-tab" :class="statusFilter==='expired' ? 'active' : ''">Expired</button>
      </div>
      <div class="relative w-full sm:w-56">
        <input type="text" x-model.debounce.250ms="searchQuery" placeholder="Cari voucher…"
               class="search-input w-full pl-8 pr-3 py-2 text-sm text-slate-700 placeholder-slate-400" aria-label="Cari voucher" />
        <i class="fas fa-search absolute left-3 top-2.5 text-slate-300 text-xs"></i>
      </div>
    </div>
  </div>

  {# ── BULK ACTION BAR ── #}
  <div x-show="selectedIds.length > 0" x-cloak x-transition
       class="bulk-bar px-4 py-3 flex items-center gap-3 flex-wrap rounded-xl"
       style="background:rgba(15,23,42,0.9); backdrop-filter:var(--glass-blur);">
    <span class="text-white text-xs font-semibold" x-text="selectedIds.length + ' dipilih'"></span>
    <div class="flex items-center gap-2">
      <button @click="bulkToggleActive(true)" class="flex items-center gap-1.5 text-xs font-semibold text-white bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-all">
        <i class="fas fa-toggle-on text-[10px]"></i> Aktifkan
      </button>
      <button @click="bulkToggleActive(false)" class="flex items-center gap-1.5 text-xs font-semibold text-white bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-all">
        <i class="fas fa-toggle-off text-[10px]"></i> Nonaktifkan
      </button>
      <button @click="bulkDelete()" class="flex items-center gap-1.5 text-xs font-semibold text-rose-300 bg-rose-500 hover:bg-rose-600 px-3 py-1.5 rounded-lg transition-all">
        <i class="fas fa-trash text-[10px]"></i> Hapus
      </button>
    </div>
    <button @click="selectedIds=[]" class="ml-auto w-6 h-6 flex items-center justify-center rounded-lg text-white hover:bg-white/20 transition-all">
      <i class="fas fa-times text-xs"></i>
    </button>
  </div>

  {# ── VOUCHER LIST ── #}
  <div class="space-y-3" role="list" aria-label="Daftar voucher">

    {# Skeleton #}
    <template x-if="isLoading">
      <template x-for="i in 3" :key="'sk-'+i">
        <div class="voucher-card"><div class="flex items-center gap-4"><div class="skeleton-line" style="width:48px;height:48px;border-radius:12px;"></div><div class="flex-1 space-y-2"><div class="h-3 skeleton-line" style="width:50%;"></div><div class="h-2.5 skeleton-line" style="width:70%;"></div><div class="h-2.5 skeleton-line" style="width:40%;"></div></div></div></div>
      </template>
    </template>

    {# Cards #}
    <template x-if="!isLoading">
      <template x-for="v in filteredVouchers" :key="v.id">
        <div class="voucher-card relative pl-7"
             :class="'status-' + v.computedStatus"
             role="listitem">
          {# Color stripe #}
          <div class="voucher-stripe"
               :style="'background:' + (v.type==='percentage' ? '#059669' : '#2563EB')"></div>

          <div class="flex items-start gap-4">
            {# Checkbox #}
            <input type="checkbox" class="mt-1 w-3.5 h-3.5 accent-emerald-500 rounded cursor-pointer flex-shrink-0"
                   :checked="selectedIds.includes(v.id)"
                   @change="toggleSelect(v.id)"
                   :aria-label="'Pilih: ' + v.name" />

            {# Discount circle #}
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-white text-xs font-bold"
                 :style="'background:' + (v.type==='percentage' ? '#059669' : '#2563EB')">
              <span x-text="v.type === 'percentage' ? v.value + '%' : formatRpShort(v.value)"></span>
            </div>

            {# Info #}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <h3 class="text-sm font-bold text-slate-800 truncate" x-text="v.name"></h3>
                <span class="status-badge" :class="'badge-' + v.computedStatus" x-text="statusLabel(v.computedStatus)"></span>
                <span class="status-badge" :class="'badge-' + v.type" x-text="v.type === 'percentage' ? 'Persen' : 'Nominal'"></span>
              </div>

              <div class="flex items-center gap-3 text-[11px] text-slate-400 mb-2 flex-wrap">
                <span class="font-mono tracking-wider font-semibold text-slate-500" x-text="v.code"></span>
                <span><i class="fas fa-calendar-alt mr-1"></i><span x-text="v.validity_label"></span></span>
                <span x-show="v.min_purchase > 0"><i class="fas fa-shopping-cart mr-1"></i>Min. <span x-text="formatRp(v.min_purchase)"></span></span>
              </div>

              {# Usage progress #}
              <div class="flex items-center gap-3">
                <div class="usage-bar-track flex-1 max-w-xs">
                  <div class="usage-bar-fill"
                       :style="'width:' + usagePercent(v) + '%; background:' + (usagePercent(v) > 80 ? '#F59E0B' : v.type==='percentage' ? '#059669' : '#2563EB')">
                  </div>
                </div>
                <span class="text-[10px] font-semibold whitespace-nowrap"
                      :class="usagePercent(v) > 80 ? 'text-amber-600' : 'text-slate-400'"
                      x-text="v.used_count + (v.usage_limit > 0 ? '/' + v.usage_limit : '') + ' terpakai'"></span>
              </div>
            </div>

            {# Actions #}
            <div class="flex items-center gap-0.5 flex-shrink-0">
              <button class="icon-btn" @click="duplicateVoucher(v)" title="Duplikat"><i class="fas fa-copy"></i></button>
              <a :href="editUrl(v.id)" class="icon-btn" title="Edit"><i class="fas fa-pen"></i></a>
              <button class="icon-btn danger" @click="confirmDelete(v)" title="Hapus"><i class="fas fa-trash"></i></button>
            </div>
          </div>
        </div>
      </template>
    </template>

    {# Empty #}
    <div x-show="!isLoading && filteredVouchers.length === 0" x-cloak
         class="glass-card p-12 text-center">
      <div class="empty-icon w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-3 bg-slate-100">
        <i class="fas fa-ticket-alt text-slate-200 text-2xl"></i>
      </div>
      <p class="text-sm font-semibold text-slate-500">Belum ada voucher</p>
      <p class="text-xs text-slate-400 mt-1" x-text="statusFilter ? 'Tidak ada voucher dengan filter ini' : 'Buat voucher pertama Anda'"></p>
      <a href="{% url 'create_voucher' %}"
         class="inline-flex items-center gap-1.5 mt-4 text-xs font-semibold transition-colors"
         style="color:var(--color-emerald-600);">
        <i class="fas fa-plus text-[10px]"></i> Buat Voucher
      </a>
    </div>
  </div>

</div>

{# ── DELETE CONFIRM MODAL ── #}
<div x-show="showDeleteModal" x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background:rgba(15,23,42,0.4); backdrop-filter:var(--glass-blur);"
     @click.self="showDeleteModal=false" role="dialog" aria-modal="true">
  <div class="modal-box rounded-2xl overflow-hidden shadow-2xl w-full max-w-sm"
       style="background:rgba(255,255,255,0.95); backdrop-filter:var(--glass-blur);">
    <div class="p-6 text-center">
      <div class="w-14 h-14 rounded-full bg-rose-50 flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-trash text-rose-500 text-xl"></i>
      </div>
      <h3 class="text-base font-bold text-slate-800">Hapus Voucher?</h3>
      <p class="text-sm text-slate-500 mt-1">
        "<span class="font-semibold" x-text="deleteTarget?.name"></span>" akan dihapus permanen.
      </p>
      <p x-show="deleteTarget?.used_count > 0" class="text-xs text-amber-600 mt-2 font-medium">
        <i class="fas fa-exclamation-triangle mr-1"></i>
        Voucher ini sudah dipakai <span x-text="deleteTarget?.used_count"></span> kali
      </p>
    </div>
    <div class="px-6 pb-6 flex gap-2">
      <button @click="showDeleteModal=false" class="btn btn-outline flex-1">Batal</button>
      <button @click="doDelete()" class="flex-1 px-4 py-2.5 text-sm font-semibold text-white bg-rose-500 hover:bg-rose-600 rounded-xl transition-all">
        Hapus
      </button>
    </div>
  </div>
</div>

{# ── TOAST ── #}
<div class="fixed bottom-4 right-4 z-50 space-y-2" x-data aria-live="polite" aria-atomic="true">
  <template x-for="t in $store.toasts.list" :key="t.id">
    <div class="flex items-center gap-3 px-4 py-3 rounded-xl shadow-2xl min-w-56 max-w-xs text-white text-sm"
         style="background:rgba(15,23,42,0.9); backdrop-filter:var(--glass-blur);"
         :class="{
           'border-l-4 border-emerald-400': t.type==='success',
           'border-l-4 border-blue-400'   : t.type==='info',
           'border-l-4 border-amber-400'  : t.type==='warning',
           'border-l-4 border-rose-400'   : t.type==='error',
         }">
      <i :class="t.icon" class="text-xs flex-shrink-0"></i>
      <span x-text="t.message"></span>
    </div>
  </template>
</div>

<script id="vouchers-list-data" type="application/json">{{ vouchers_json|default:"[]"|safe }}</script>
{% endblock %}

{% block dashboard_scripts %}
<script>
document.addEventListener('alpine:init', () => {
  if (!Alpine.store('toasts')) {
    Alpine.store('toasts', {
      list: [], _id: 0,
      show(message, type='success', icon='fas fa-check-circle') {
        const id = ++this._id;
        this.list.push({ id, message, type, icon });
        setTimeout(() => { this.list = this.list.filter(t => t.id !== id); }, 2900);
      }
    });
  }
});
</script>
{% endblock %}

{% block scripts %}
<script>
const EDIT_BASE = '{% url "edit_voucher" pk=0 %}'.replace(/\/0\/?$/, '');

function voucherListApp() {
  return {
    vouchers      : [],
    searchQuery   : '',
    statusFilter  : '',
    isLoading     : false,
    selectedIds   : [],
    showDeleteModal: false,
    deleteTarget  : null,

    init() {
      this.isLoading = true;
      const raw = document.getElementById('vouchers-list-data');
      if (raw?.textContent) {
        try { const p = JSON.parse(raw.textContent); if (Array.isArray(p)) this.vouchers = p; } catch {}
      }
      if (this.vouchers.length === 0) {
        const now = new Date();
        this.vouchers = [
          { id:1, name:'Diskon Gayo Wine 10%', code:'GAYO10', type:'percentage', value:10, max_discount:15000, min_purchase:25000, valid_from: now.toISOString(), valid_to: new Date(now.getTime()+7*86400000).toISOString(), usage_limit:100, used_count:43, is_active:true,
            validity_label: formatDateRange(now, new Date(now.getTime()+7*86400000)) },
          { id:2, name:'Diskon Rp 5.000 All Menu', code:'DISKON5K', type:'fixed', value:5000, max_discount:null, min_purchase:30000, valid_from: now.toISOString(), valid_to: new Date(now.getTime()+30*86400000).toISOString(), usage_limit:200, used_count:128, is_active:true,
            validity_label: formatDateRange(now, new Date(now.getTime()+30*86400000)) },
          { id:3, name:'Promo Launch Matcha Latte', code:'MATCHA20', type:'percentage', value:20, max_discount:20000, min_purchase:0, valid_from: new Date(now.getTime()+3*86400000).toISOString(), valid_to: new Date(now.getTime()+10*86400000).toISOString(), usage_limit:50, used_count:0, is_active:true,
            validity_label: formatDateRange(new Date(now.getTime()+3*86400000), new Date(now.getTime()+10*86400000)) },
          { id:4, name:'Flash Sale Pastry', code:'PASTRY50', type:'percentage', value:50, max_discount:25000, min_purchase:15000, valid_from: new Date(now.getTime()-10*86400000).toISOString(), valid_to: new Date(now.getTime()-3*86400000).toISOString(), usage_limit:30, used_count:30, is_active:false,
            validity_label: formatDateRange(new Date(now.getTime()-10*86400000), new Date(now.getTime()-3*86400000)) },
          { id:5, name:'Voucher Tahun Baru (Draft)', code:'NEWYEAR25', type:'fixed', value:25000, max_discount:null, min_purchase:100000, valid_from:'', valid_to:'', usage_limit:0, used_count:0, is_active:false,
            validity_label:'Belum ditentukan' },
        ];
        /* Compute status for mock */
        this.vouchers.forEach(v => { v.computedStatus = computeStatus(v); });
      } else {
        this.vouchers.forEach(v => { v.computedStatus = computeStatus(v); });
      }
      this.isLoading = false;

      const io = new IntersectionObserver(entries => {
        entries.forEach((e, i) => {
          if (e.isIntersecting) { setTimeout(() => e.target.classList.add('visible'), i * 60); io.unobserve(e.target); }
        });
      }, { threshold: .08 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    },

    get filteredVouchers() {
      const q = this.searchQuery.trim().toLowerCase(), s = this.statusFilter;
      return this.vouchers.filter(v => {
        if (q && !v.name.toLowerCase().includes(q) && !v.code.toLowerCase().includes(q)) return false;
        if (s && v.computedStatus !== s) return false;
        return true;
      });
    },
    get activeCount()   { return this.vouchers.filter(v => v.computedStatus === 'active').length; },
    get expiredCount()  { return this.vouchers.filter(v => v.computedStatus === 'expired').length; },
    get totalUsedCount(){ return this.vouchers.reduce((a, v) => a + (v.used_count || 0), 0); },

    toggleSelect(id) {
      this.selectedIds.includes(id)
        ? this.selectedIds = this.selectedIds.filter(x => x !== id)
        : this.selectedIds.push(id);
    },

    editUrl(id) { return EDIT_BASE + '/' + id + '/'; },

    usagePercent(v) {
      if (!v.usage_limit || v.usage_limit === 0) return 0;
      return Math.min(100, Math.round((v.used_count / v.usage_limit) * 100));
    },

    statusLabel(s) {
      return { active: 'Aktif', expired: 'Expired', draft: 'Draft', upcoming: 'Akan Datang' }[s] || s;
    },

    formatRp(n) { return 'Rp ' + Number(n||0).toLocaleString('id-ID'); },
    formatRpShort(n) {
      if (n >= 1000000) return (n/1000000).toFixed(0) + 'jt';
      if (n >= 1000) return (n/1000).toFixed(0) + 'rb';
      return String(n);
    },

    duplicateVoucher(v) {
      Alpine.store('toasts').show('Voucher "' + v.name + '" diduplikasi (simulasi)', 'info', 'fas fa-copy');
    },

    confirmDelete(v) { this.deleteTarget = v; this.showDeleteModal = true; },

    doDelete() {
      if (!this.deleteTarget) return;
      const name = this.deleteTarget.name;
      this.vouchers = this.vouchers.filter(v => v.id !== this.deleteTarget.id);
      this.selectedIds = this.selectedIds.filter(id => id !== this.deleteTarget.id);
      this.showDeleteModal = false;
      this.deleteTarget = null;
      Alpine.store('toasts').show('"' + name + '" dihapus', 'warning', 'fas fa-trash');
    },

    bulkToggleActive(active) {
      this.vouchers.forEach(v => {
        if (this.selectedIds.includes(v.id)) { v.is_active = active; v.computedStatus = computeStatus(v); }
      });
      Alpine.store('toasts').show(this.selectedIds.length + ' voucher ' + (active ? 'diaktifkan' : 'dinonaktifkan'), 'success', active ? 'fas fa-toggle-on' : 'fas fa-toggle-off');
      this.selectedIds = [];
    },

    bulkDelete() {
      const c = this.selectedIds.length;
      this.vouchers = this.vouchers.filter(v => !this.selectedIds.includes(v.id));
      this.selectedIds = [];
      Alpine.store('toasts').show(c + ' voucher dihapus', 'warning', 'fas fa-trash');
    },
  };
}

/* Helper — bukan bagian Alpine, dipakai saat init mock */
function computeStatus(v) {
  if (!v.is_active && (!v.valid_from || !v.valid_to)) return 'draft';
  if (!v.is_active) return 'draft';
  const now = new Date(), from = v.valid_from ? new Date(v.valid_from) : null, to = v.valid_to ? new Date(v.valid_to) : null;
  if (to && now > to) return 'expired';
  if (from && now < from) return 'upcoming';
  return 'active';
}

function formatDateRange(from, to) {
  try {
    const opts = { day:'numeric', month:'short' };
    return from.toLocaleDateString('id-ID', opts) + ' – ' + to.toLocaleDateString('id-ID', { ...opts, year:'numeric' });
  } catch { return '-'; }
}
</script>
{% endblock %}