{% extends 'base/base.html' %}
{% block title %}Pencatatan Bahan — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  .glass-panel { background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid white; padding: 32px; }
  .form-row { display: grid; grid-template-columns: 3fr 1fr 1fr 40px; gap: 12px; align-items: center; margin-bottom: 12px; }
  .form-input { padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; background: white; width: 100%; outline: none; }
  .form-input:focus { border-color: #0f172a; }
</style>
{% endblock %}

{% block content %}
<div class="w-full max-w-5xl mx-auto relative z-10 space-y-6" x-data="consumptionApp()" x-init="init()" x-cloak>
  
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Pencatatan Konsumsi Bahan</h1>
      <p class="text-sm text-slate-500">Catat pengeluaran bahan untuk PO #<span x-text="poCode"></span></p>
    </div>
    <button class="px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-bold shadow hover:bg-emerald-700 transition">
      <i class="fas fa-save mr-2"></i> Simpan & Kurangi Stok
    </button>
  </div>

  <div class="glass-panel">
    <!-- Summary Header -->
    <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-100">
      <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500">
        <i class="fas fa-boxes"></i>
      </div>
      <div>
        <h3 class="font-bold text-slate-800" x-text="productName"></h3>
        <p class="text-xs text-slate-400">Target Produksi: <span x-text="targetQty" class="font-bold text-slate-600"></span> Pcs</p>
      </div>
    </div>

    <!-- Table Header -->
    <div class="form-row text-xs font-bold text-slate-400 uppercase mb-2">
      <div>Nama Bahan</div>
      <div>Standar (BOM)</div>
      <div>Aktual Dipakai</div>
      <div></div>
    </div>

    <!-- Rows -->
    <div class="space-y-1">
      <template x-for="(item, index) in items" :key="index">
        <div class="form-row bg-white rounded-lg p-2 border border-slate-100 shadow-sm">
          <div>
            <input type="text" x-model="item.name" class="form-input font-medium text-slate-700" disabled>
            <div class="text-[10px] text-slate-400 mt-1">Stok: <span class="text-emerald-600 font-bold" x-text="item.stock"></span></div>
          </div>
          <div class="text-center font-mono text-slate-500 py-3" x-text="item.std_qty + ' ' + item.uom"></div>
          <div>
            <input type="number" x-model.number="item.actual_qty" class="form-input text-right font-bold text-slate-800" placeholder="0">
          </div>
          <div class="text-center">
            <button @click="items.splice(index, 1)" class="text-rose-400 hover:text-rose-600 p-2"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </template>
    </div>

    <!-- Add Button -->
    <button @click="addItem()" class="w-full mt-4 py-3 border-2 border-dashed border-slate-200 rounded-xl text-slate-400 font-bold text-sm hover:bg-slate-50 hover:text-slate-600 transition">
      <i class="fas fa-plus mr-2"></i> Tambah Baris Bahan (Manual)
    </button>

    <!-- Variance Info -->
    <div class="mt-8 bg-amber-50 border border-amber-100 p-4 rounded-xl flex items-start gap-3">
      <i class="fas fa-info-circle text-amber-500 mt-1"></i>
      <div>
        <h4 class="text-sm font-bold text-amber-800">Perhatian Variasi (Variance)</h4>
        <p class="text-xs text-amber-700 mt-1">Sistem akan otomatis menghitung selisih antara pemakaian aktual dan standar BOM. Jika selisih besar, harap isi alasan di catatan.</p>
      </div>
    </div>

    <div class="mt-4">
      <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alasan Variasi / Waste</label>
      <textarea class="w-full p-3 border border-slate-200 rounded-xl outline-none focus:border-slate-400 text-sm" rows="3" placeholder="Contoh: Adonan gagal, pembuangan sisa, dll..."></textarea>
    </div>

  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function consumptionApp() {
  return {
    poCode: 'PO-2310-001',
    productName: 'Croissant Butter',
    targetQty: 200,
    items: [
      { name: 'Tepung Terigu Premium', std_qty: 10000, uom: 'gr', actual_qty: 10200, stock: '50kg' },
      { name: 'Mentega Wijsman', std_qty: 4000, uom: 'gr', actual_qty: 3950, stock: '10kg' },
      { name: 'Susu UHT Full Cream', std_qty: 6000, uom: 'ml', actual_qty: 6000, stock: '20L' },
      { name: 'Gula Halus', std_qty: 1500, uom: 'gr', actual_qty: 1600, stock: '15kg' },
    ],
    
    init() {
      // Parse URL to get PO ID and load BOM
    },
    
    addItem() {
      this.items.push({ name: '', std_qty: 0, uom: 'gr', actual_qty: 0, stock: '-' });
    }
  }
}
</script>
{% endblock %}