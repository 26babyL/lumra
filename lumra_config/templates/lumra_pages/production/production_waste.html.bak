{% extends 'base/base.html' %}
{% block title %}Pencatatan Waste — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  [x-cloak] { display: none !important; }
  .glass-panel { background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid white; padding: 32px; }
  .waste-row { display: grid; grid-template-columns: 3fr 2fr 1fr 40px; gap: 12px; align-items: center; background: white; padding: 12px; border-radius: 12px; border: 1px solid #f1f5f9; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .form-select { width: 100%; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; background: white; outline: none; }
  .cost-display { background: #fef2f2; color: #991b1b; padding: 16px; border-radius: 12px; border: 1px solid #fee2e2; }
</style>
{% endblock %}

{% block content %}
<div class="w-full max-w-5xl mx-auto relative z-10 space-y-6" x-data="wasteApp()" x-init="init()" x-cloak>
  
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Pencatatan Waste (Sisa)</h1>
      <p class="text-sm text-slate-500">Rekam bahan yang rusak, terbuang, atau tidak terpakai.</p>
    </div>
    <div class="text-right">
      <p class="text-xs text-slate-400 font-bold uppercase">Referensi PO</p>
      <p class="font-mono font-bold text-slate-800" x-text="poCode"></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left: Form List -->
    <div class="lg:col-span-2 glass-panel space-y-4">
      <h3 class="font-bold text-slate-700 border-b pb-2">Daftar Barang Rusak / Sisa</h3>
      
      <div class="text-xs font-bold text-slate-400 uppercase grid grid-cols-12 gap-2 px-2">
        <div class="col-span-5">Bahan Baku</div>
        <div class="col-span-3">Alasan</div>
        <div class="col-span-2 text-right">Qty</div>
        <div class="col-span-1"></div>
      </div>

      <div class="space-y-3">
        <template x-for="(waste, index) in wastes" :key="index">
          <div class="waste-row">
            <div>
              <select x-model="waste.material_id" class="form-select text-sm">
                <option value="">Pilih Bahan...</option>
                <option value="1">Tepung Terigu</option>
                <option value="2">Mentega</option>
                <option value="3">Susu UHT</option>
                <option value="4">Gula</option>
              </select>
            </div>
            <div>
              <select x-model="waste.reason" class="form-select text-sm">
                <option value="burnt">Gosong</option>
                <option value="dropped">Jatuh / Kotor</option>
                <option value="expired">Kedaluwarsa</option>
                <option value="error">Kesalahan Proses</option>
                <option value="leftover">Sisa Adonan</option>
              </select>
            </div>
            <div>
              <input type="number" x-model.number="waste.qty" class="w-full text-right font-bold text-slate-700 outline-none border-b border-slate-200 focus:border-rose-500 bg-transparent">
            </div>
            <div class="text-center">
              <button @click="removeWaste(index)" class="text-rose-400 hover:text-rose-600 p-2"><i class="fas fa-trash"></i></button>
            </div>
          </div>
        </template>
      </div>

      <button @click="addWaste()" class="w-full py-3 border-2 border-dashed border-slate-200 rounded-xl text-slate-400 font-bold text-sm hover:bg-slate-50 hover:text-slate-600 transition">
        <i class="fas fa-plus mr-2"></i> Tambah Baris Waste
      </button>
    </div>

    <!-- Right: Summary -->
    <div class="space-y-6">
      <div class="cost-display">
        <h3 class="font-bold text-rose-800 mb-1">Total Nilai Kerugian</h3>
        <p class="text-3xl font-black text-rose-600" x-text="formatCurrency(totalLoss)"></p>
        <p class="text-xs text-rose-400 mt-2">Biaya ini akan menambah HPP aktual.</p>
      </div>

      <div class="bg-white p-4 rounded-xl border border-slate-100 shadow-sm">
        <h4 class="font-bold text-slate-700 text-sm mb-3">Ringkasan Qty</h4>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-slate-500">Total Item Waste</span><span class="font-bold" x-text="totalItems + ' Jenis'"></span></div>
          <div class="flex justify-between"><span class="text-slate-500">Total Berat/Volume</span><span class="font-bold" x-text="totalQty + ' Unit'"></span></div>
        </div>
      </div>

      <button @click="saveWaste()" class="w-full py-3 bg-slate-800 text-white rounded-xl font-bold shadow hover:bg-slate-700 transition">
        Simpan & Adjust Inventory
      </button>
    </div>

  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function wasteApp() {
  return {
    poCode: 'PO-2310-001',
    wastes: [
      { material_id: '1', reason: 'burnt', qty: 500 },
      { material_id: '2', reason: 'dropped', qty: 100 }
    ],
    // Mock prices per unit for demo
    prices: { '1': 15000, '2': 50000, '3': 500, '4': 200 }, // per kg or liter usually

    addWaste() {
      this.wastes.push({ material_id: '', reason: 'burnt', qty: 0 });
    },
    
    removeWaste(index) {
      this.wastes.splice(index, 1);
    },

    get totalItems() {
      return this.wastes.filter(w => w.material_id !== '').length;
    },

    get totalQty() {
      return this.wastes.reduce((sum, w) => sum + (w.qty || 0), 0);
    },

    get totalLoss() {
      return this.wastes.reduce((sum, w) => {
        const price = this.prices[w.material_id] || 0;
        // Assuming price is per 1000g for simplicity in demo logic
        return sum + (price * (w.qty / 1000));
      }, 0);
    },

    formatCurrency(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(num);
    },

    init(){},
    
    saveWaste() {
      alert('Waste berhasil dicatat. Stok bahan akan dikurangi.');
      window.location.href = 'production_order_list.html';
    }
  }
}
</script>
{% endblock %}