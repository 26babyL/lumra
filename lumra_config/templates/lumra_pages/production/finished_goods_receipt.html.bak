{% extends 'base/base.html' %}
{% block title %}Penerimaan Barang Jadi — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  [x-cloak] { display: none !important; }
  .glass-panel { background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid white; padding: 32px; }
  .form-input { width: 100%; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 10px; background: rgba(255,255,255,0.5); transition: 0.2s; }
  .form-input:focus { background: white; border-color: #0f172a; outline: none; }
  
  .qc-card { border: 2px dashed #e2e8f0; border-radius: 16px; padding: 20px; transition: 0.2s; }
  .qc-card:focus-within { border-color: #0f172a; background: #f8fafc; }
</style>
{% endblock %}

{% block content %}
<div class="w-full max-w-4xl mx-auto relative z-10 space-y-6" x-data="fgApp()" x-init="init()" x-cloak>
  
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">QC & Penerimaan Barang Jadi</h1>
      <p class="text-sm text-slate-500">Verifikasi kualitas dan masukkan ke stok gudang.</p>
    </div>
    <div class="text-right">
      <p class="text-xs text-slate-400 font-bold uppercase">Referensi PO</p>
      <p class="font-mono font-bold text-slate-800 text-lg" x-text="po.code"></p>
    </div>
  </div>

  <div class="glass-panel space-y-8">
    
    <!-- Produk Info -->
    <div class="flex items-center gap-4 bg-slate-50 p-4 rounded-xl">
      <div class="w-16 h-16 bg-white rounded-xl shadow-sm flex items-center justify-center text-2xl">🥐</div>
      <div>
        <h3 class="font-bold text-slate-800 text-lg" x-text="po.product"></h3>
        <p class="text-sm text-slate-500">Target Produksi: <span x-text="po.target_qty" class="font-bold text-slate-700"></span> Pcs</p>
      </div>
    </div>

    <!-- QC Section -->
    <div>
      <h3 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
        <i class="fas fa-clipboard-check text-emerald-500"></i> Hasil Inspeksi Kualitas
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Good Items -->
        <div class="qc-card bg-emerald-50/30">
          <label class="block text-xs font-bold text-emerald-700 uppercase mb-2">Jumlah Bagus (Accepted)</label>
          <div class="flex items-center gap-3">
            <input type="number" x-model.number="fg.qty_good" class="form-input text-2xl font-bold text-emerald-700 text-center bg-white" placeholder="0">
            <span class="text-sm text-emerald-600 font-bold">Pcs</span>
          </div>
        </div>

        <!-- Rejected Items -->
        <div class="qc-card bg-rose-50/30">
          <label class="block text-xs font-bold text-rose-700 uppercase mb-2">Jumlah Rusak (Rejected)</label>
          <div class="flex items-center gap-3">
            <input type="number" x-model.number="fg.qty_reject" class="form-input text-2xl font-bold text-rose-700 text-center bg-white" placeholder="0">
            <span class="text-sm text-rose-600 font-bold">Pcs</span>
          </div>
        </div>
      </div>

      <!-- Variance Warning -->
      <div x-show="totalInspected !== po.target_qty" class="mt-4 flex items-start gap-3 p-3 bg-amber-50 rounded-xl border border-amber-100">
        <i class="fas fa-exclamation-triangle text-amber-500 mt-0.5"></i>
        <div>
          <p class="text-xs font-bold text-amber-800">Selisih Terdeteksi</p>
          <p class="text-xs text-amber-700">Target: <span x-text="po.target_qty"></span> | Terinspeksi: <span x-text="totalInspected"></span>. Pastikan tidak ada barang tertinggal.</p>
        </div>
      </div>
    </div>

    <!-- Storage Assignment -->
    <div>
      <h3 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
        <i class="fas fa-warehouse text-blue-500"></i> Lokasi Penyimpanan
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kode Lot Barang Jadi</label>
          <input type="text" x-model="fg.lot_code" class="form-input font-mono">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Zone Gudang</label>
          <select x-model="fg.zone" class="form-input">
            <option value="">Pilih Zone...</option>
            <option value="Z-01">Z-01 (Rak Siap Jual)</option>
            <option value="Z-02">Z-02 (Area Pendingin)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Action -->
    <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
      <button class="px-6 py-2.5 rounded-xl text-sm font-bold text-slate-500 hover:bg-slate-100 transition">Batal</button>
      <button @click="saveReceipt()" class="px-8 py-2.5 rounded-xl text-sm font-bold bg-emerald-600 text-white shadow-lg hover:bg-emerald-700 transition flex items-center gap-2">
        <i class="fas fa-check-circle"></i> Terima ke Stok
      </button>
    </div>

  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function fgApp() {
  return {
    po: {
      code: 'PO-2310-001',
      product: 'Croissant Butter',
      target_qty: 200
    },
    fg: {
      qty_good: 0,
      qty_reject: 0,
      lot_code: 'FG-' + new Date().toISOString().slice(0,10).replace(/-/g,''),
      zone: ''
    },
    
    get totalInspected() {
      return this.fg.qty_good + this.fg.qty_reject;
    },

    init() {},

    saveReceipt() {
      if(this.fg.qty_good === 0) {
        return alert('Jumlah barang bagus tidak boleh 0');
      }
      if(!this.fg.zone) {
        return alert('Tentukan lokasi penyimpanan');
      }
      alert(`Berhasil memasukkan ${this.fg.qty_good} pcs ke Stok Gudang Zone ${this.fg.zone}`);
      window.location.href = 'production_order_list.html';
    }
  }
}
</script>
{% endblock %}