{% extends 'base/base.html' %}
{% block title %}Detail Resep — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  .cost-bar-bg { background: #f1f5f9; border-radius: 99px; height: 12px; overflow: hidden; display: flex; }
  .cost-seg { height: 100%; transition: width 1s ease; }
  
  .ver-tab { padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; color: #64748b; cursor: pointer; transition: 0.2s; border: 1px solid transparent; }
  .ver-tab.active { background: white; color: #0f172a; border-color: #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
</style>
{% endblock %}

{% block content %}
<div class="w-full max-w-6xl mx-auto relative z-10 space-y-6" x-data="bomDetailApp()" x-init="init()" x-cloak>
  
  <!-- Header -->
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-3 mb-2">
        <span class="px-2 py-1 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded uppercase">Aktif</span>
        <h1 class="text-2xl font-bold text-slate-800" x-text="bom.name"></h1>
      </div>
      <p class="text-sm text-slate-500">SKU: <span class="font-mono" x-text="bom.sku"></span> • Output: <span x-text="bom.yield"></span></p>
    </div>
    <div class="flex gap-2">
      <button class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg text-sm font-bold hover:bg-slate-50">Duplikat</button>
      <button class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-bold shadow hover:bg-slate-700">Edit Resep</button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left: Ingredients Table -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Cost Structure Visual -->
      <div class="bg-white/80 backdrop-blur rounded-2xl p-6 border border-white shadow-sm">
        <h3 class="font-bold text-slate-700 mb-4 text-sm">Struktur Biaya Bahan</h3>
        
        <div class="space-y-4 mb-4">
          <template x-for="cat in costCategories" :key="cat.name">
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-bold text-slate-600" x-text="cat.name"></span>
                <span class="text-slate-800" x-text="formatCurrency(cat.amount) + ' (' + cat.pct + '%)'"></span>
              </div>
              <div class="cost-bar-bg">
                <div class="cost-seg" :style="`width: ${cat.pct}%; background-color: ${cat.color}`"></div>
              </div>
            </div>
          </template>
        </div>
        
        <div class="flex justify-between pt-3 border-t border-slate-100">
          <span class="font-bold text-slate-700">Total Bahan Baku</span>
          <span class="font-bold text-emerald-600 text-lg" x-text="formatCurrency(bom.total_cost)"></span>
        </div>
      </div>

      <!-- Detailed Table -->
      <div class="bg-white/80 backdrop-blur rounded-2xl p-6 border border-white shadow-sm">
        <h3 class="font-bold text-slate-700 mb-4 text-sm">Daftar Bahan (Rinci)</h3>
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 text-slate-500 uppercase text-xs">
            <tr>
              <th class="py-3 rounded-l-lg">Bahan Baku</th>
              <th class="py-3 text-center">Qty</th>
              <th class="py-3 text-right">Harga Satuan</th>
              <th class="py-3 text-right rounded-r-lg">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <template x-for="item in bom.ingredients" :key="item.id">
              <tr>
                <td class="py-3">
                  <div class="font-medium text-slate-800" x-text="item.name"></div>
                  <div class="text-[10px] text-slate-400" x-text="item.category"></div>
                </td>
                <td class="py-3 text-center font-mono text-slate-600" x-text="item.qty + ' ' + item.uom"></td>
                <td class="py-3 text-right text-slate-500" x-text="formatCurrency(item.unit_price)"></td>
                <td class="py-3 text-right font-bold text-slate-700" x-text="formatCurrency(item.total)"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

    </div>

    <!-- Right: Meta & History -->
    <div class="space-y-6">
      
      <!-- Production Cost Card -->
      <div class="bg-slate-800 text-white rounded-2xl p-6 shadow-xl">
        <h3 class="font-bold text-slate-300 text-xs uppercase mb-4">Kalkulasi HPP</h3>
        <div class="space-y-4">
          <div>
            <p class="text-xs text-slate-400 mb-1">Biaya Bahan</p>
            <p class="text-xl font-bold" x-text="formatCurrency(bom.total_cost)"></p>
          </div>
          <div>
            <p class="text-xs text-slate-400 mb-1">Biaya Tenaga / Packing</p>
            <div class="flex justify-between items-center">
              <input type="number" class="w-24 bg-slate-700 border border-slate-600 rounded px-2 py-1 text-right text-sm outline-none focus:border-emerald-500">
              <span class="text-sm font-bold text-emerald-400">Rp 2.000</span>
            </div>
          </div>
          <div class="border-t border-slate-600 pt-3">
            <p class="text-xs text-slate-400 mb-1">Total HPP (Estimasi)</p>
            <p class="text-2xl font-bold text-emerald-400" x-text="formatCurrency(bom.total_cost + 2000)"></p>
            <p class="text-[10px] text-slate-500 mt-1">Per Porsi</p>
          </div>
        </div>
      </div>

      <!-- Version History -->
      <div class="bg-white/80 backdrop-blur rounded-2xl p-6 border border-white shadow-sm">
        <h3 class="font-bold text-slate-700 mb-4 text-sm">Riwayat Versi</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 rounded-lg bg-emerald-50 border border-emerald-100">
            <div>
              <p class="text-sm font-bold text-slate-800">v1.2 (Aktif)</p>
              <p class="text-[10px] text-slate-500">25 Okt 2023 • oleh Admin</p>
            </div>
            <i class="fas fa-check-circle text-emerald-500"></i>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg hover:bg-slate-50 cursor-pointer">
            <div>
              <p class="text-sm font-bold text-slate-600">v1.1</p>
              <p class="text-[10px] text-slate-400">10 Sep 2023 • oleh Chef Budi</p>
            </div>
            <i class="fas fa-history text-slate-300"></i>
          </div>
          <div class="flex items-center justify-between p-3 rounded-lg hover:bg-slate-50 cursor-pointer">
            <div>
              <p class="text-sm font-bold text-slate-600">v1.0</p>
              <p class="text-[10px] text-slate-400">01 Jan 2023 • oleh System</p>
            </div>
            <i class="fas fa-history text-slate-300"></i>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
{{ bom_data|json_script:"bom-data" }}
<script>
function bomDetailApp() {
  return {
    bom: { ingredients: [], total_cost: 0 },
    get costCategories() {
      const total = this.bom.total_cost;
      // Group by category logic (simplified for demo)
      return [
        { name: 'Coffee', amount: 6000, color: '#78350f', pct: Math.round((6000/total)*100) },
        { name: 'Dairy', amount: 5000, color: '#3b82f6', pct: Math.round((5000/total)*100) },
        { name: 'Syrup', amount: 1500, color: '#d97706', pct: Math.round((1500/total)*100) }
      ];
    },
    formatCurrency(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num);
    },
    init() {
      const el = document.getElementById('bom-data');
      if (el && el.textContent) {
        try {
          const b = JSON.parse(el.textContent) || {};
          this.bom = {
            name: b.name || b.code || '',
            sku: b.finished_sku || '',
            yield: '',
            total_cost: 0,
            ingredients: (b.items || []).map((it, idx) => ({
              id: idx + 1,
              name: it.name,
              qty: it.quantity,
              uom: it.unit || '',
              unit_price: 0,
              total: 0,
              category: it.sku,
            }))
          };
        } catch(e) {
          this.bom = { ingredients: [], total_cost: 0 };
        }
      }
    }
  }
}
</script>
{% endblock %}
