{% extends 'base/base.html' %}
{% block title %}Kontrol Produksi — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  /* Visuals for Shop Floor */
  .control-panel { background: rgba(255,255,255,0.95); border-radius: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.08); border: 1px solid white; }
  
  .big-status { font-size: 3rem; font-weight: 900; line-height: 1; }
  .st-pending { color: #94a3b8; }
  .st-process { color: #2563eb; animation: pulse 2s infinite; }
  .st-completed { color: #16a34a; }
  @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.6; } 100% { opacity: 1; } }

  .control-btn { height: 60px; border-radius: 16px; font-weight: 800; font-size: 16px; transition: all 0.2s; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; }
  .btn-start { background: #10b981; color: white; box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3); }
  .btn-start:hover { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(16, 185, 129, 0.4); }
  
  .btn-stop { background: #ef4444; color: white; box-shadow: 0 10px 20px rgba(239, 68, 68, 0.3); }
  .btn-stop:hover { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(239, 68, 68, 0.4); }

  .btn-complete { background: #0f172a; color: white; box-shadow: 0 10px 20px rgba(15, 23, 42, 0.3); }

  .progress-circle { width: 120px; height: 120px; border-radius: 50%; background: conic-gradient(#0f172a var(--pct), #e2e8f0 0); display: flex; align-items: center; justify-content: center; position: relative; }
  .progress-circle::before { content:''; position: absolute; width: 100px; height: 100px; background: white; border-radius: 50%; }
  .progress-text { position: relative; z-index: 10; text-align: center; }
</style>
{% endblock %}

{% block content %}
<div class="w-full max-w-5xl mx-auto relative z-10" x-data="poDetailApp()" x-init="init()" x-cloak>
  
  <div class="control-panel p-8 space-y-8">
    
    <!-- Header & Status -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-slate-100 pb-6">
      <div>
        <h1 class="text-3xl font-black text-slate-800" x-text="po.product"></h1>
        <p class="text-slate-500 font-mono mt-1" x-text="po.code + ' • Line: ' + po.line"></p>
      </div>
      <div class="text-right mt-4 md:mt-0">
        <p class="text-xs font-bold text-slate-400 uppercase mb-1">Status Saat Ini</p>
        <div class="big-status" :class="'st-' + po.status" x-text="formatStatus(po.status)"></div>
      </div>
    </div>

    <!-- Main Control Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
      
      <!-- Left: Progress Circle -->
      <div class="flex justify-center">
        <div class="progress-circle" :style="`--pct: ${(po.produced_qty / po.target_qty) * 100}%`">
          <div class="progress-text">
            <p class="text-xs text-slate-400 font-bold uppercase">Selesai</p>
            <p class="text-2xl font-black text-slate-800" x-text="po.produced_qty"></p>
            <p class="text-xs text-slate-400">/ <span x-text="po.target_qty"></span></p>
          </div>
        </div>
      </div>

      <!-- Right: Controls & Inputs -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Quick Actions -->
        <div class="grid grid-cols-2 gap-4">
          <template x-if="po.status === 'pending'">
            <button @click="startPO()" class="control-btn btn-start col-span-2">
              <i class="fas fa-play"></i> MULAI PRODUKSI
            </button>
          </template>

          <template x-if="po.status === 'in_progress'">
            <button @click="updateQty(-1)" class="h-14 rounded-xl bg-slate-100 text-slate-600 font-bold text-xl hover:bg-slate-200 transition">-</button>
            <button @click="updateQty(1)" class="h-14 rounded-xl bg-slate-100 text-slate-600 font-bold text-xl hover:bg-slate-200 transition">+</button>
            
            <button @click="pausePO()" class="control-btn btn-stop">
              <i class="fas fa-pause"></i> JEDA / STOP
            </button>
            <button @click="completePO()" class="control-btn btn-complete" :disabled="po.produced_qty < po.target_qty">
              <i class="fas fa-check"></i> SELESAIKAN
            </button>
          </template>

          <template x-if="po.status === 'completed'">
            <div class="col-span-2 bg-emerald-50 border border-emerald-100 rounded-xl p-4 text-center">
              <i class="fas fa-check-circle text-3xl text-emerald-500 mb-2"></i>
              <p class="font-bold text-emerald-800">Produksi Selesai</p>
              <p class="text-xs text-emerald-600">Silakan lakukan material consumption.</p>
            </div>
          </template>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div class="bg-slate-50 p-3 rounded-xl">
            <p class="text-xs text-slate-400 font-bold uppercase">Waktu Mulai</p>
            <p class="font-bold text-slate-700" x-text="po.actual_start || '-'"></p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl">
            <p class="text-xs text-slate-400 font-bold uppercase">Estimasi Selesai</p>
            <p class="font-bold text-slate-700" x-text="po.estimated_end || '-'"></p>
          </div>
          <div class="bg-slate-50 p-3 rounded-xl col-span-2">
            <p class="text-xs text-slate-400 font-bold uppercase">Catatan Operator</p>
            <p class="text-slate-600" x-text="po.notes || '-'"></p>
          </div>
        </div>

      </div>
    </div>

    <!-- Footer Actions -->
    <div class="border-t border-slate-100 pt-6 flex justify-between items-center">
      <a href="{% url 'production_order_list' %}" class="text-slate-500 hover:text-slate-800 font-bold text-sm">Kembali ke Daftar</a>
      
      <template x-if="po.status === 'completed'">
        <a href="{% url 'material_consumption' %}" class="bg-emerald-600 text-white px-6 py-3 rounded-xl font-bold shadow hover:bg-emerald-700 transition flex items-center gap-2">
          <i class="fas fa-boxes"></i> Catat Pemakaian Bahan
        </a>
      </template>
    </div>

  </div>
</div>
{% endblock %}

{% block scripts %}
{{ po_data|json_script:"po-data" }}
<script>
function poDetailApp() {
  return {
    po: {},
    
    init() {
      const el = document.getElementById('po-data');
      if (el && el.textContent) {
        try {
          const p = JSON.parse(el.textContent) || {};
          this.po = {
            code: p.code,
            product: p.product,
            line: p.line || '',
            target_qty: p.target_qty || 0,
            produced_qty: p.produced_qty || 0,
            status: p.status || 'pending',
            actual_start: null,
            estimated_end: '',
            notes: p.notes || '',
          };
        } catch(e) {
          this.po = {};
        }
      }
    },

    formatStatus(s) { return s.replace('_', ' '); },

    startPO() {
      if(confirm('Mulai produksi sekarang?')) {
        this.po.status = 'in_progress';
        this.po.actual_start = new Date().toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'});
      }
    },

    pausePO() {
      if(confirm('Jeda produksi?')) {
        this.po.status = 'pending'; // Or specific 'paused' status
      }
    },

    updateQty(delta) {
      const newQty = this.po.produced_qty + delta;
      if(newQty >= 0 && newQty <= this.po.target_qty + 10) { // Allow slight overproduction
        this.po.produced_qty = newQty;
      }
    },

    completePO() {
      if(confirm('Selesaikan produksi ini?')) {
        this.po.status = 'completed';
      }
    }
  }
}
</script>
{% endblock %}
