{% extends 'base/base.html' %}

{% block title %}Layar Kunci - LUMRA{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="bg-gradient-to-b from-slate-900/90 to-slate-800 rounded-2xl border border-slate-700/50 backdrop-blur-xl shadow-2xl overflow-hidden text-center">
      <!-- Avatar -->
      <div class="pt-8">
        <div class="w-20 h-20 mx-auto bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-full flex items-center justify-center">
          <i class="fas fa-user text-3xl text-white"></i>
        </div>
      </div>

      <!-- User Info -->
      <div class="px-8 py-6 border-b border-slate-700">
        <h1 class="text-2xl font-bold text-slate-100">{{ request.user.get_full_name }}</h1>
        <p class="text-slate-400 text-sm">{{ request.user.email }}</p>
      </div>

      <!-- Unlock Form -->
      <form method="post" class="px-8 py-8">
        {% csrf_token %}

        <p class="text-slate-400 mb-6">Masukkan password untuk membuka kunci</p>

        {% if error %}
          <div class="mb-4 p-3 bg-red-900/30 border border-red-700 rounded-lg text-red-300 text-sm">
            {{ error }}
          </div>
        {% endif %}

        <!-- Password -->
        <input type="password" name="password" required class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition mb-6" placeholder="••••••••">

        <!-- Submit -->
        <button type="submit" class="w-full py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-semibold rounded-lg transition">
          Buka Kunci
        </button>
      </form>

      <!-- Logout -->
      <div class="px-8 py-4 border-t border-slate-700 text-center">
        <a href="{% url 'auth:logout' %}" class="text-slate-400 hover:text-slate-300 text-sm transition">
          <i class="fas fa-sign-out-alt mr-2"></i> Logout
        </a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
