{% extends 'base/base.html' %}

{% block title %}Two-Factor Authentication - LUMRA{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="bg-gradient-to-b from-slate-900/90 to-slate-800 rounded-2xl border border-slate-700/50 backdrop-blur-xl shadow-2xl overflow-hidden">
      <!-- Header -->
      <div class="bg-gradient-to-r from-emerald-900/40 to-slate-900 px-8 py-6 border-b border-slate-700">
        <h1 class="text-2xl font-bold text-emerald-400 mb-2">2FA Setup</h1>
        <p class="text-slate-400 text-sm">Aktifkan Two-Factor Authentication untuk keamanan ekstra</p>
      </div>

      <!-- Form -->
      <form method="post" class="px-8 py-8">
        {% csrf_token %}

        <!-- QR Code -->
        <div class="mb-6 p-4 bg-slate-800/50 rounded-lg text-center">
          <p class="text-slate-400 text-sm mb-3">Scan dengan authenticator app:</p>
          {% if qr_code %}
            <img src="{{ qr_code }}" alt="QR Code" class="w-32 h-32 mx-auto">
          {% else %}
            <div class="w-32 h-32 mx-auto bg-slate-700 rounded flex items-center justify-center">
              <i class="fas fa-qrcode text-3xl text-slate-600"></i>
            </div>
          {% endif %}
        </div>

        <!-- Atau manual -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-slate-300 mb-2">Atau masukkan manual:</label>
          <input type="text" value="{{ secret_key }}" readonly class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-slate-100 text-xs font-mono cursor-pointer" onclick="copyToClipboard()">
        </div>

        <!-- Verifikasi -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-slate-300 mb-2">Kode Verifikasi</label>
          <input type="text" name="verification_code" required maxlength="6" class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-slate-100 text-center tracking-widest focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition" placeholder="000000">
        </div>

        <!-- Submit -->
        <button type="submit" class="w-full py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-semibold rounded-lg transition">
          <i class="fas fa-check mr-2"></i> Aktifkan 2FA
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function copyToClipboard() {
    const text = document.querySelector('input[readonly]').value;
    navigator.clipboard.writeText(text).then(() => {
      alert('Secret key berhasil disalin');
    });
  }
</script>
{% endblock %}
