
<style>
/* Auth Page Glass — lumra_glass_fix.py fase 2 */
.auth-page-bg {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--navy) 0%, #1A1A1A 45%, #003D2F 100%);
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;
}
.auth-blob {
  position: absolute; border-radius: 50%; filter: blur(80px);
  opacity: 0.18; pointer-events: none;
  animation: drift 16s ease-in-out infinite alternate;
}
.auth-blob-1 { width:420px; height:420px; background:var(--em); top:-80px; left:-100px; }
.auth-blob-2 { width:300px; height:300px; background:var(--navy); bottom:-60px; right:-80px; animation-delay:-6s; }
.auth-blob-3 { width:200px; height:200px; background:#008B61; top:50%; left:60%; animation-delay:-3s; }
.auth-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid rgba(0, 103, 79, 0.1);
  border-radius: 24px;
  box-shadow: 0 20px 60px var(--color-black-a040), 0 0 0 0.5px rgba(255, 255, 255, 0.85);
  padding: 40px; width: 100%; max-width: 420px;
  position: relative; z-index: 10;
}
.auth-input {
  background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(0, 103, 79, 0.1);
  border-radius: 12px; color: white; padding: 12px 16px; width: 100%;
  outline: var(--shadow-sm-16); transition: border-color 0.2s, box-shadow 0.2s;
}
.auth-input::placeholder { color: rgba(0, 103, 79, 0.1); }
.auth-input:focus { border-color: var(--em); box-shadow: 0 0 0 3px var(--em-08); }
.auth-btn {
  background: linear-gradient(135deg, var(--em), var(--jade)); border: var(--shadow-sm-16);
  border-radius: 12px; color: white; font-weight: 700; padding: 12px;
  width: 100%; cursor: pointer; transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 15px var(--color-emerald-700-a040);
}
.auth-btn:hover { opacity: 0.92; transform: translateY(-1px); box-shadow: 0 8px 25px var(--em-15); }

</style>
{% extends 'base/base.html' %}

{% block title %}Login - CoffeeShop{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden" style="background: linear-gradient(135deg, var(--em-08) 0%, var(--jade-08) 50%, var(--em-12) 100%);">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-10 left-10 w-20 h-20 rounded-full blur-xl" style="background-color: var(--em-15);"></div>
        <div class="absolute bottom-10 right-10 w-32 h-32 rounded-full blur-xl" style="background-color: var(--jade-12);"></div>
        <div class="absolute top-1 left-1 transform -translate-x-1 -translate-y-1 w-40 h-40 rounded-full blur-2xl" style="background-color: var(--em-12);"></div>
    </div>

    <div class="max-w-md w-full space-y-8 p-10 rounded-3xl shadow-2xl relative z-10 transform transition-all duration-500 hover:scale-105" style="background:rgba(255, 255, 255, 0.92); border: 1px solid var(--em-12);">
        <div class="text-center">
            <div class="mx-auto h-20 w-20 rounded-full flex items-center justify-center shadow-xl animate-pulse" style="background: linear-gradient(135deg, var(--em) 0%, var(--jade) 100%);">
                <i class="fas fa-coffee text-white text-4xl"></i>
            </div>
            <h2 class="mt-6 text-center text-4xl font-extrabold text-slate-800" style="background: linear-gradient(90deg, var(--em) 0%, var(--jade) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                Selamat Datang Kembali
            </h2>
            <p class="mt-2 text-center text-sm font-medium" style="color: var(--em);">
                Silakan login untuk mengelola CoffeeShop
            </p>
        </div>

        <form class="mt-8 space-y-6" method="POST" id="loginForm">
            {% csrf_token %}
            
            {% if error %}
            <div class="style="background-color: var(--em-08);" border-l-4 border-red-500 p-4 mb-4 rounded-lg animate-bounce">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-triangle text-red-500 mr-2"></i>
                    <p class="text-sm text-red-700 font-medium">{{ error }}</p>
                </div>
            </div>
            {% endif %}

            <div class="rounded-md shadow-sm space-y-4">
                <div>
                    <label for="id_username" class="block text-sm font-semibold text-slate-700 mb-2">Username</label>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center transition-colors" style="color: var(--jade);" style="--focus-color: var(--em);">
                            <i class="fas fa-user"></i>
                        </span>
                        <input id="id_username" name="username" type="text" required 
                            class="appearance-none rounded-xl relative block w-full px-12 py-4 placeholder-opacity-60 text-slate-800 focus:outline-none focus:ring-4 transition-all duration-300 sm:text-sm" 
                            style="border: 2px solid var(--em-15); background-color: var(--em-08); --placeholder-color: var(--em-12); focus:border-color: var(--em); focus:ring-color: var(--em-08); focus:bg-white;" 
                            placeholder="Masukkan username">
                    </div>
                </div>
                
                <div>
                    <label for="id_password" class="block text-sm font-semibold text-slate-700 mb-2">Password</label>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center transition-colors" style="color: var(--jade);">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input id="id_password" name="password" type="password" required 
                            class="appearance-none rounded-xl relative block w-full px-12 py-4 text-slate-800 focus:outline-none focus:ring-4 transition-all duration-300 sm:text-sm" 
                            style="border: 2px solid var(--em-15); background-color: var(--em-08);" 
                            placeholder="••••••••">
                        <button type="button" class="absolute inset-y-0 right-0 pr-4 flex items-center transition-colors" style="color: var(--jade);" onclick="togglePassword()">
                            <i class="fas fa-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input id="remember-me" name="remember-me" type="checkbox" class="h-4 w-4 rounded" style="accent-color: var(--em); border-color: var(--em-15);">
                        <label for="remember-me" class="ml-2 block text-sm text-slate-700 font-medium">
                            Ingat saya
                        </label>
                    </div>
                </div>
            </div>

            <div>
                <button type="submit" id="loginBtn"
                    class="group relative w-full flex justify-center py-4 px-4 border border-transparent text-sm font-bold rounded-xl text-white focus:outline-none focus:ring-4 transition-all duration-300 transform hover:scale-105 shadow-lg" 
                    style="background: linear-gradient(135deg, var(--em) 0%, var(--jade) 100%); --focus-ring-color: var(--em-12);">
                    <span class="absolute left-0 inset-y-0 flex items-center pl-4" style="color: var(--jade-12);">
                        <i class="fas fa-sign-in-alt transition-colors"></i>
                    </span>
                    <span id="btnText">MASUK KE DASHBOARD</span>
                    <div class="hidden ml-2" id="loadingSpinner">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                </button>
            </div>
            
            <input type="hidden" name="next" value="{{ next }}">
        </form>

        <div class="text-center mt-6">
            <p class="text-xs italic transition-colors cursor-pointer" style="color: var(--em);">
                Lupa password? Hubungi Administrator IT.
            </p>
        </div>

        <!-- Footer Branding -->
        <div class="text-center mt-8 pt-6" style="border-top: 1px solid var(--em-12);">
            <p class="text-xs text-slate-400">
                Powered by <span class="font-semibold" style="color: var(--em);">CoffeeShop</span> Management System
            </p>
        </div>
    </div>
</div>

<script>
function togglePassword() {
    const passwordInput = document.getElementById('id_password');
    const toggleIcon = document.getElementById('toggleIcon');
    if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleIcon.classList.remove('fa-eye');
        toggleIcon.classList.add('fa-eye-slash');
    } else {
        passwordInput.type = 'password';
        toggleIcon.classList.remove('fa-eye-slash');
        toggleIcon.classList.add('fa-eye');
    }
}

document.getElementById('loginForm').addEventListener('submit', function(e) {
    const btn = document.getElementById('loginBtn');
    const btnText = document.getElementById('btnText');
    const spinner = document.getElementById('loadingSpinner');
    
    btn.disabled = true;
    btnText.textContent = 'Sedang Masuk...';
    spinner.classList.remove('hidden');
    
    // Re-enable after 3 seconds if no redirect (for demo purposes)
    setTimeout(() => {
        btn.disabled = false;
        btnText.textContent = 'MASUK KE DASHBOARD';
        spinner.classList.add('hidden');
    }, 3000);
});
</script>
{% endblock %}