{% extends 'base/base.html' %}

{% block title %}Reset Password - LUMRA{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center px-4">
  {% include 'base/partials/bg_blob.html' with position='top-left' %}
  {% include 'base/partials/bg_blob.html' with position='bottom-right' %}

  <div class="w-full max-w-md">
    <div class="bg-gradient-to-b from-slate-900/90 to-slate-800 rounded-2xl border border-slate-700/50 backdrop-blur-xl shadow-2xl overflow-hidden">
      <!-- Header -->
      <div class="bg-gradient-to-r from-emerald-900/40 to-slate-900 px-8 py-6 border-b border-slate-700">
        <h1 class="text-2xl font-bold text-emerald-400 mb-2">Reset Password</h1>
        <p class="text-slate-400 text-sm">Masukkan password baru Anda</p>
      </div>

      <!-- Form -->
      <form method="post" class="px-8 py-8">
        {% csrf_token %}

        {% if error %}
          <div class="mb-6 p-4 bg-red-900/30 border border-red-700 rounded-lg text-red-300 text-sm">
            {{ error }}
          </div>
        {% endif %}

        <!-- Password Baru -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-slate-300 mb-2">Password Baru</label>
          <input type="password" name="password1" required class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition" placeholder="••••••••">
        </div>

        <!-- Konfirmasi Password -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-slate-300 mb-2">Konfirmasi Password</label>
          <input type="password" name="password2" required class="w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-lg text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition" placeholder="••••••••">
        </div>

        <!-- Submit -->
        <button type="submit" class="w-full py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-semibold rounded-lg transition shadow-lg">
          <i class="fas fa-check mr-2"></i> Reset Password
        </button>

        <div class="mt-6 text-center">
          <p class="text-slate-400 text-sm">
            <a href="{% url 'auth:login' %}" class="text-emerald-400 hover:text-emerald-300 transition font-medium">Kembali ke login</a>
          </p>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
