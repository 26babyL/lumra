{% extends 'base/base.html' %}
{% block title %}Buat Akun — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  .glass-panel { background: rgba(255,255,255,0.95); backdrop-filter: blur(12px); border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid white; padding: 32px; max-width: 600px; margin: 0 auto; }
  .form-input { width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; background: rgba(255,255,255,0.5); transition: 0.2s; }
  .form-input:focus { background: white; border-color: #0f172a; outline: none; }
</style>
{% endblock %}

{% block content %}
<div class="w-full relative z-10 flex items-center justify-center min-h-[80vh]" x-data="coaFormApp()" x-cloak>
  
  <div class="glass-panel w-full">
    <div class="mb-6">
      <h1 class="text-xl font-bold text-slate-800">Buat Akun Baru</h1>
      <p class="text-sm text-slate-500">Menambahkan struktur ke Chart of Accounts.</p>
    </div>

    <form method="post" @submit="prepareSubmit" class="space-y-5">
      {% csrf_token %}
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kode Akun</label>
        <div class="flex gap-2">
          <input type="text" name="code" x-model="form.code" placeholder="Cth: 1-101" class="form-input font-mono font-bold">
          <button type="button" class="px-4 bg-slate-100 text-slate-600 rounded-lg font-bold text-sm hover:bg-slate-200">Cek Ketersediaan</button>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Akun</label>
        <input type="text" name="name" x-model="form.name" placeholder="Cth: Kas Kecil" class="form-input">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tipe Akun</label>
          <select name="type" x-model="form.type" class="form-input">
            <option value="asset">Asset (Aset)</option>
            <option value="liability">Liability (Kewajiban)</option>
            <option value="equity">Equity (Modal)</option>
            <option value="revenue">Revenue (Pendapatan)</option>
            <option value="expense">Expense (Beban)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Level Akun</label>
          <select name="level" x-model="form.level" class="form-input">
            <option value="1">Header (Kelompok)</option>
            <option value="2">Detail (Aktif)</option>
          </select>
        </div>
      </div>

      <div x-show="form.level == 2">
        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Akun Induk (Parent)</label>
        <select name="parent_id" x-model="form.parent_id" class="form-input">
          <option value="">-- Tidak Ada --</option>
          {% for parent in parent_accounts %}
          <option value="{{ parent.id }}">{{ parent.code }} {{ parent.name }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="pt-4 flex justify-end gap-3 border-t border-slate-100">
        <a href="{% url 'chart_of_accounts' %}" class="px-6 py-2.5 rounded-lg text-sm font-bold text-slate-600 hover:bg-slate-100 transition">Batal</a>
        <button type="submit" class="px-8 py-2.5 rounded-lg text-sm font-bold bg-slate-800 text-white shadow-lg hover:bg-slate-700 transition">Simpan Akun</button>
      </div>
    </form>
  </div>

</div>
{% endblock %}

{% block scripts %}
<script>
function coaFormApp() {
  return {
    form: {
      code: '{{ form_data.code|escapejs }}',
      name: '{{ form_data.name|escapejs }}',
      type: '{{ form_data.type|default:"asset"|escapejs }}',
      level: '{{ form_data.level|default:"2" }}',
      parent_id: '{{ form_data.parent_id|default:""|escapejs }}'
    },
    prepareSubmit(event) {
      if(!this.form.code || !this.form.name) {
        event.preventDefault();
        alert('Mohon lengkapi kode dan nama akun');
      }
    }
  }
}
</script>
{% endblock %}
