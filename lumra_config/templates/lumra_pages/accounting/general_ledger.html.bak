{% extends 'base/base.html' %}
{% block title %}Buku Besar - CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  .glass-panel { background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid white; padding: 32px; }
  .ledger-table { width: 100%; border-collapse: collapse; }
  .ledger-table th { text-align: left; padding: 12px; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; border-bottom: 2px solid #e2e8f0; }
  .ledger-table td { padding: 12px; border-bottom: 1px solid #f1f5f9; font-size: 13px; }
  .col-money { text-align: right; font-family: monospace; font-weight: 600; }
  .col-balance { text-align: right; font-weight: 700; color: #0f172a; }
</style>
{% endblock %}

{% block content %}
<div class="w-full flex-1 space-y-6 relative z-10" x-data="ledgerApp()" x-init="init()">
  <form method="get" x-ref="filterForm" class="glass-panel mb-6">
    <div class="flex flex-col md:flex-row justify-between items-end gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Buku Besar (General Ledger)</h1>
        <div class="mt-2 flex items-center gap-3">
          <div>
            <label class="block text-[10px] font-bold text-slate-400 uppercase">Akun</label>
            <select name="account" @change="$refs.filterForm.submit()" class="bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold text-slate-700 outline-none focus:border-slate-400 w-64">
              {% for account in accounts %}
              <option value="{{ account.id }}" {% if selected_account_id == account.id|stringformat:"s" %}selected{% endif %}>{{ account.code }} {{ account.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-slate-400 uppercase">Periode</label>
            <input type="month" name="period" value="{{ period }}" @change="$refs.filterForm.submit()" class="bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-700 outline-none focus:border-slate-400">
          </div>
        </div>
      </div>
    </div>
  </form>

  <div class="glass-panel overflow-x-auto">
    <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-100">
      <h2 class="font-bold text-slate-700">{{ account_name }}</h2>
      <div class="text-right">
        <span class="text-xs text-slate-400 block">Saldo Awal</span>
        <span class="font-mono font-bold text-slate-800" x-text="formatCurrency(openingBalance)"></span>
      </div>
    </div>

    <table class="ledger-table">
      <thead>
        <tr>
          <th style="width: 15%">Tanggal</th>
          <th style="width: 15%">Ref</th>
          <th style="width: 40%">Keterangan</th>
          <th style="width: 10%" class="col-money">Debit</th>
          <th style="width: 10%" class="col-money">Kredit</th>
          <th style="width: 10%" class="col-balance">Saldo</th>
        </tr>
      </thead>
      <tbody>
        <tr class="bg-slate-50">
          <td class="text-slate-400 text-xs" colspan="3">Saldo Awal</td>
          <td class="col-money text-slate-400">-</td>
          <td class="col-money text-slate-400">-</td>
          <td class="col-balance text-slate-600" x-text="formatCurrency(openingBalance)"></td>
        </tr>

        <template x-for="trx in transactions" :key="trx.id">
          <tr>
            <td class="text-slate-500" x-text="trx.date"></td>
            <td class="font-mono text-xs text-slate-400" x-text="trx.ref"></td>
            <td class="text-slate-700" x-text="trx.desc"></td>
            <td class="col-money" x-text="trx.debit ? formatCurrency(trx.debit) : '-'"></td>
            <td class="col-money" x-text="trx.credit ? formatCurrency(trx.credit) : '-'"></td>
            <td class="col-balance" x-text="formatCurrency(trx.balance)"></td>
          </tr>
        </template>
      </tbody>
      <tfoot class="font-bold bg-slate-50 border-t-2 border-slate-200">
        <tr>
          <td colspan="3" class="text-right">Saldo Akhir</td>
          <td class="col-money">-</td>
          <td class="col-money">-</td>
          <td class="col-balance text-emerald-600" x-text="formatCurrency(closingBalance)"></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script id="transactions-data" type="application/json">
{{ transactions_json|safe }}
</script>

<script>
function ledgerApp() {
  return {
    openingBalance: {{ opening_balance|default:0 

    init() {
      const _transactionsRaw = document.getElementById('transactions-data');
      if (_transactionsRaw) {
        try { this.transactions = JSON.parse(_transactionsRaw.textContent); }
        catch(e) { console.error('transactions-data parse error:', e); }
      }
    },
  }},
    transactions: [],
    get closingBalance() {
      if (this.transactions.length === 0) return this.openingBalance;
      return this.transactions[this.transactions.length - 1].balance;
    },
    formatCurrency(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num || 0);
    }
  }
}
</script>
{% endblock %}
