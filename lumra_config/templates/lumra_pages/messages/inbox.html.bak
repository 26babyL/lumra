{% extends 'base/base.html' %}

{% block title %}Pesan Pribadi — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  [x-cloak] { display: none !important; }

  /* ── Thread Row ── */
  .thread-item {
    background     : var(--color-surface-mid);
    backdrop-filter: var(--glass-blur) saturate(150%);
    border         : 1px solid rgba(255, 255, 255, 0.95);
    border-radius  : 14px;
    box-shadow     : 0 1px 6px var(--color-black-a004);
    padding        : 14px 16px;
    cursor         : pointer;
    transition     : box-shadow .18s, transform .18s, border-color .18s;
    text-decoration: none;
    display        : block;
  }
  .thread-item:hover {
    box-shadow  : 0 4px 16px var(--color-black-a008);
    transform   : translateY(-1px);
    border-color: var(--color-emerald-600-a03);
  }
  .thread-item.unread {
    border-left : 3px solid #008B61;
    background  : rgba(5, 150, 105, 0.03);
  }
  .thread-item.unread .thread-name { color: #1E293B; font-weight: 700; }
  .thread-item.unread .thread-preview { color: #475569; }

  .thread-avatar {
    width : 40px; height: 40px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 14px; flex-shrink: 0;
  }
  .thread-badge {
    min-width        : 20px; height: 20px;
    border-radius    : 10px;
    background       : var(--color-emerald-600);
    color            : white;
    font-size        : 10px; font-weight: 700;
    display          : inline-flex; align-items: center; justify-content: center;
    padding          : 0 6px;
  }
  .thread-name    { font-size: 13px; font-weight: 600; color: #334155; }
  .thread-role    { font-size: 10px; color: #94A3B8; font-weight: 500; }
  .thread-preview { font-size: 12px; color: #64748B; line-height: 1.4; }
  .thread-time    { font-size: 10px; color: #94A3B8; white-space: nowrap; }

  /* ── Stat Card ── */
  .stat-card {
    background     : var(--color-surface-mid);
    backdrop-filter: var(--glass-blur);
    border         : 1px solid rgba(255, 255, 255, 0.85);
    border-radius  : 16px;
    box-shadow     : 0 2px 10px var(--color-black-a005);
    padding        : 16px 20px;
    transition     : box-shadow .2s, transform .2s;
  }
  .stat-card:hover { box-shadow: 0 6px 20px var(--color-black-a009); transform: translateY(-1px); }
  .stat-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0;
  }

  /* ── Filter Tab ── */
  .filter-tab {
    padding: 5px 14px; border-radius: 8px;
    font-size: 11px; font-weight: 600;
    color: #999; background: transparent;
    cursor: pointer; white-space: nowrap;
    transition: background .12s, color .12s;
    border: none;
  }
  .filter-tab:hover { background: var(--color-emerald-600-a08); color: #003D2F; }
  .filter-tab.active { background: var(--color-emerald-600-a12); color: var(--color-primary); }

  /* ── Search ── */
  .search-input {
    background   : rgba(255, 255, 255, 0.85);
    border       : 1px solid var(--color-slate-300-a05, rgba(203,213,225,0.5));
    border-radius: 10px;
    transition   : background .15s, border-color .15s, box-shadow .15s;
  }
  .search-input:focus {
    background  : #FFF;
    border-color: var(--color-emerald-600-a08);
    box-shadow  : 0 0 0 3px var(--color-emerald-600-a08);
    outline     : none;
  }

  /* ── Empty ── */
  @keyframes breathe { 0%,100%{opacity:.4;transform:scale(1);} 50%{opacity:.7;transform:scale(1.05);} }
  .empty-icon { animation: breathe 3s ease-in-out infinite; }

  /* ── Skeleton ── */
  @keyframes shimmer { 0%,100%{opacity:.5;} 50%{opacity:1;} }
  .skeleton-line { animation: shimmer 1.4s infinite; background: #F1F5F9; border-radius: 6px; }
</style>
{% endblock %}

{% block content %}
<div class="bg-blob bg-blob-1" aria-hidden="true"></div>
<div class="bg-blob bg-blob-2" aria-hidden="true"></div>

<div class="w-full flex-1 space-y-5 relative z-10"
     x-data="inboxThreadsApp()"
     x-init="init()"
     x-cloak>

  {# ── HEADER ── #}
  <div class="reveal flex items-end justify-between gap-3">
    <div>
      <nav class="flex items-center gap-2 text-xs mb-1" style="color:var(--color-emerald-600);" aria-label="Breadcrumb">
        <a href="{% url 'dashboard' %}" class="hover:text-slate-700 transition-colors">Dashboard</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-600 font-medium">Pesan Pribadi</span>
      </nav>
      <h1 class="text-2xl font-bold text-slate-800">Pesan Pribadi</h1>
      <p class="text-sm text-slate-400 mt-0.5">Percakapan antar staf — dua arah</p>
    </div>
    <a href="{% url 'compose_message' %}"
       class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white rounded-xl transition-all"
       style="background:var(--color-emerald-600); box-shadow:0 4px 14px rgba(5,150,105,0.25);"
       onmouseover="this.style.background='#047857'"
       onmouseout="this.style.background='var(--color-emerald-600)'">
      <i class="fas fa-pen text-xs"></i> Pesan Baru
    </a>
  </div>

  {# ── STAT CARDS ── #}
  <div class="reveal grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon" style="background:var(--color-emerald-600-a08); color:var(--color-emerald-600);">
        <i class="fas fa-comments"></i>
      </div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Total</p>
        <p class="text-xl font-bold text-slate-800" x-text="threads.length"></p>
      </div>
    </div>
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon bg-blue-50 text-blue-500"><i class="fas fa-envelope"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Belum Dibaca</p>
        <p class="text-xl font-bold text-slate-800" x-text="unreadCount"></p>
      </div>
    </div>
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon bg-amber-50 text-amber-500"><i class="fas fa-clock"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Hari Ini</p>
        <p class="text-xl font-bold text-slate-800" x-text="todayCount"></p>
      </div>
    </div>
    <div class="stat-card flex items-center gap-3">
      <div class="stat-icon bg-emerald-50 text-emerald-500"><i class="fas fa-user-check"></i></div>
      <div>
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Staf Aktif</p>
        <p class="text-xl font-bold text-slate-800" x-text="activeStaffCount"></p>
      </div>
    </div>
  </div>

  {# ── TOOLBAR ── #}
  <div class="reveal glass-card px-4 py-3">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      {# Filter tabs #}
      <div class="flex items-center gap-0.5 flex-wrap">
        <button @click="statusFilter='';searchQuery=''" class="filter-tab" :class="statusFilter==='' ? 'active' : ''">Semua</button>
        <button @click="statusFilter='unread'" class="filter-tab" :class="statusFilter==='unread' ? 'active' : ''">
          Belum Dibaca
          <span x-show="unreadCount > 0"
                class="ml-1 text-[9px] font-bold rounded-full px-1.5 py-0.5 text-white"
                style="background:var(--color-emerald-600);"
                x-text="unreadCount"></span>
        </button>
        <button @click="statusFilter='read'" class="filter-tab" :class="statusFilter==='read' ? 'active' : ''">Sudah Dibaca</button>
      </div>
      {# Search #}
      <div class="relative w-full sm:w-60">
        <input type="text"
               x-model.debounce.250ms="searchQuery"
               placeholder="Cari percakapan…"
               class="search-input w-full pl-8 pr-3 py-2 text-sm text-slate-700 placeholder-slate-400"
               aria-label="Cari percakapan" />
        <i class="fas fa-search absolute left-3 top-2.5 text-slate-300 text-xs"></i>
      </div>
    </div>
  </div>

  {# ── THREAD LIST ── #}
  <div class="space-y-2" role="list" aria-label="Daftar percakapan">

    {# Skeleton loading #}
    <template x-if="isLoading">
      <template x-for="i in 4" :key="'sk-'+i">
        <div class="thread-item">
          <div class="flex items-center gap-3">
            <div class="thread-avatar skeleton-line" style="width:40px;height:40px;"></div>
            <div class="flex-1 space-y-2">
              <div class="h-3 skeleton-line" style="width:40%;"></div>
              <div class="h-2.5 skeleton-line" style="width:70%;"></div>
            </div>
          </div>
        </div>
      </template>
    </template>

    {# Thread items #}
    <template x-if="!isLoading">
      <template x-for="thread in filteredThreads" :key="thread.id">
        <a :href="threadUrl(thread.id)"
           class="thread-item"
           :class="{ 'unread': !thread.is_read }"
           role="listitem"
           @click.prevent="goToThread(thread)">
          <div class="flex items-start gap-3">
            {# Avatar #}
            <div class="thread-avatar"
                 :style="'background:' + avatarBg(thread.sender_role) + '; color:' + avatarColor(thread.sender_role)"
                 x-text="thread.sender_name.charAt(0)">
            </div>

            {# Content #}
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="thread-name truncate" x-text="thread.sender_name"></span>
                  <span class="thread-role" x-text="thread.sender_role"></span>
                  <span x-show="thread.is_online"
                        class="w-1.5 h-1.5 bg-emerald-400 rounded-full flex-shrink-0"
                        title="Online"></span>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <span class="thread-time" x-text="thread.time"></span>
                  <span x-show="thread.message_count > 1" class="thread-badge" x-text="thread.message_count"></span>
                </div>
              </div>
              <p class="thread-preview truncate mt-0.5" x-text="thread.last_message"></p>
            </div>

            {# Unread dot #}
            <div x-show="!thread.is_read"
                 class="w-2.5 h-2.5 rounded-full mt-2 flex-shrink-0"
                 style="background:var(--color-emerald-600);"></div>
          </div>
        </a>
      </template>
    </template>

    {# Empty state #}
    <div x-show="!isLoading && filteredThreads.length === 0"
         x-cloak
         class="glass-card p-12 text-center">
      <div class="empty-icon w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-3 bg-slate-100">
        <i class="fas fa-comments text-slate-200 text-2xl"></i>
      </div>
      <p class="text-sm font-semibold text-slate-500">Tidak ada percakapan</p>
      <p class="text-xs text-slate-400 mt-1" x-text="statusFilter === 'unread' ? 'Semua pesan sudah dibaca' : 'Mulai percakapan baru dengan staf'"></p>
      <a href="{% url 'compose_message' %}"
         class="inline-flex items-center gap-1.5 mt-4 text-xs font-semibold transition-colors"
         style="color:var(--color-emerald-600);"
         onmouseover="this.style.color='var(--color-navy)'"
         onmouseout="this.style.color='var(--color-emerald-600)'">
        <i class="fas fa-pen text-[10px]"></i> Tulis Pesan Baru
      </a>
    </div>
  </div>

</div>

{# ── TOAST ── #}
<div class="fixed bottom-4 right-4 z-50 space-y-2" x-data aria-live="polite" aria-atomic="true">
  <template x-for="t in $store.toasts.list" :key="t.id">
    <div class="flex items-center gap-3 px-4 py-3 rounded-xl shadow-2xl min-w-56 max-w-xs text-white text-sm"
         style="background:rgba(15,23,42,0.9); backdrop-filter:var(--glass-blur);"
         :class="{
           'border-l-4 border-emerald-400': t.type==='success',
           'border-l-4 border-blue-400'   : t.type==='info',
           'border-l-4 border-amber-400'  : t.type==='warning',
           'border-l-4 border-rose-400'   : t.type==='error',
         }">
      <i :class="t.icon" class="text-xs flex-shrink-0"></i>
      <span x-text="t.message"></span>
    </div>
  </template>
</div>

{# ── Data JSON dari Django ── #}
<script id="threads-data" type="application/json">{{ threads_json|default:"[]"|safe }}</script>
{% endblock %}

{% block dashboard_scripts %}
<script>
document.addEventListener('alpine:init', () => {
  if (!Alpine.store('toasts')) {
    Alpine.store('toasts', {
      list: [], _id: 0,
      show(message, type = 'success', icon = 'fas fa-check-circle') {
        const id = ++this._id;
        this.list.push({ id, message, type, icon });
        setTimeout(() => { this.list = this.list.filter(t => t.id !== id); }, 2900);
      }
    });
  }
});
</script>
{% endblock %}

{% block scripts %}
<script>
/* URL pattern — disesuaikan dengan urls.py Anda */
const THREAD_BASE = '{% url "message_detail" pk=0 %}'.replace(/\/0\/?$/, '');

function inboxThreadsApp() {
  return {
    threads      : [],
    searchQuery  : '',
    statusFilter : '',
    isLoading    : false,

    init() {
      this.isLoading = true;
      const raw = document.getElementById('threads-data');
      if (raw?.textContent) {
        try {
          const parsed = JSON.parse(raw.textContent);
          if (Array.isArray(parsed)) {
            this.threads = parsed.map(t => ({
              ...t,
              time: this.formatTime(t.updated_at),
            }));
          }
        } catch(e) { this.threads = []; }
      }
      /* Fallback mock data jika kosong (untuk development) */
      if (this.threads.length === 0) {
        this.threads = [
          { id: 1, sender_name: 'Budi', sender_role: 'Kasir', is_read: false, is_online: true, last_message: 'Boss, stok gula habis nih.', message_count: 3, updated_at: new Date().toISOString() },
          { id: 2, sender_name: 'Siti', sender_role: 'Manajer', is_read: true, is_online: true, last_message: 'Oke, laporan opname sudah dikirim.', message_count: 2, updated_at: new Date(Date.now() - 86400000).toISOString() },
          { id: 3, sender_name: 'Andi', sender_role: 'Gudang', is_read: true, is_online: false, last_message: 'Barang supplier baru datang.', message_count: 1, updated_at: new Date(Date.now() - 172800000).toISOString() },
          { id: 4, sender_name: 'Dewi', sender_role: 'Kasir', is_read: false, is_online: false, last_message: 'Shift malam saya minta tukar boleh?', message_count: 5, updated_at: new Date(Date.now() - 3600000).toISOString() },
        ];
        this.threads.forEach(t => t.time = this.formatTime(t.updated_at));
      }
      this.isLoading = false;

      /* Scroll reveal */
      const io = new IntersectionObserver(entries => {
        entries.forEach((e, i) => {
          if (e.isIntersecting) { setTimeout(() => e.target.classList.add('visible'), i * 60); io.unobserve(e.target); }
        });
      }, { threshold: .08 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    },

    /* ── Computed ── */
    get filteredThreads() {
      const q  = this.searchQuery.trim().toLowerCase();
      const st = this.statusFilter;
      return this.threads.filter(t => {
        if (q && !t.sender_name.toLowerCase().includes(q) && !t.last_message.toLowerCase().includes(q)) return false;
        if (st === 'unread' && t.is_read)  return false;
        if (st === 'read'   && !t.is_read) return false;
        return true;
      });
    },
    get unreadCount()      { return this.threads.filter(t => !t.is_read).length; },
    get todayCount()       { return this.threads.filter(t => this.isToday(t.updated_at)).length; },
    get activeStaffCount() { return new Set(this.threads.filter(t => t.is_online).map(t => t.sender_name)).size; },

    /* ── Methods ── */
    threadUrl(id) { return THREAD_BASE + '/' + id + '/'; },

    goToThread(thread) {
      /* Tandai sudah dibaca (client-side, bisa juga via API) */
      if (!thread.is_read) {
        thread.is_read = true;
        /* fetch(`/api/threads/${thread.id}/read/`, { method: 'POST' }).catch(() => {}); */
      }
      window.location.href = this.threadUrl(thread.id);
    },

    avatarBg(role) {
      const map = { 'Kasir': 'rgba(5,150,105,0.1)', 'Manajer': 'rgba(37,99,235,0.1)', 'Gudang': 'rgba(245,158,11,0.1)', 'Kebersihan': 'rgba(139,92,246,0.1)' };
      return map[role] || 'rgba(100,116,139,0.1)';
    },
    avatarColor(role) {
      const map = { 'Kasir': '#059669', 'Manajer': '#2563EB', 'Gudang': '#D97706', 'Kebersihan': '#7C3AED' };
      return map[role] || '#64748B';
    },

    formatTime(iso) {
      if (!iso) return '';
      try {
        const d = new Date(iso), now = new Date();
        const diffMin = Math.floor((now - d) / 60000);
        const diffHr  = Math.floor(diffMin / 60);
        const diffDay = Math.floor(diffHr / 24);
        if (diffMin < 1) return 'Baru saja';
        if (diffMin < 60) return diffMin + ' mnt lalu';
        if (diffHr < 24)  return d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        if (diffDay === 1) return 'Kemarin';
        if (diffDay < 7)  return diffDay + ' hari lalu';
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
      } catch { return ''; }
    },

    isToday(iso) {
      if (!iso) return false;
      try {
        const d = new Date(iso), now = new Date();
        return d.toDateString() === now.toDateString();
      } catch { return false; }
    },
  };
}
</script>
{% endblock %}