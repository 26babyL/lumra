{% extends 'base/base.html' %}
{% block title %}Input Batch — CoffeeShop{% endblock %}

{% block extra_css %}
<style>
  .glass-panel { background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); border-radius: 20px; padding: 32px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); border: 1px solid white; max-width: 700px; margin: 0 auto; }
  .form-input { width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 12px; background: rgba(255,255,255,0.5); transition: 0.2s; font-size: 14px; }
  .form-input:focus { background: white; border-color: #00B8A3; outline: none; box-shadow: 0 0 0 3px rgba(0, 184, 163, 0.1); }
  
  .calc-box { background: #f8fafc; border-radius: 12px; padding: 16px; border: 1px dashed #cbd5e1; }
</style>
{% endblock %}

{% block content %}
<div class="w-full relative z-10 flex items-center justify-center min-h-[80vh]" x-data="batchFormApp()" x-init="init()" x-cloak>
  
  <div class="glass-panel w-full">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-slate-800">Input Batch Baru</h1>
      <p class="text-sm text-slate-500 mt-1">Catat kedatangan barang dengan detail lot</p>
    </div>

    <form @submit.prevent="submitForm" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kode Batch / Lot</label>
          <input type="text" x-model="form.code" placeholder="Otomatis / Manual" class="form-input font-mono">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Produk</label>
          <select x-model="form.variant_id" class="form-input">
            <option value="">Pilih Produk...</option>
            <template x-for="v in variants" :key="v.id">
              <option :value="v.id" x-text="v.sku + ' — ' + v.product"></option>
            </template>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Lokasi</label>
          <select x-model="form.location_id" class="form-input">
            <option value="">Pilih Lokasi...</option>
            <template x-for="l in locations" :key="l.id">
              <option :value="l.id" x-text="l.name"></option>
            </template>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Zona (Opsional)</label>
          <select x-model="form.zone_id" class="form-input">
            <option value="">-</option>
            <template x-for="z in filteredZones" :key="z.id">
              <option :value="z.id" x-text="z.code + ' — ' + z.name"></option>
            </template>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kuantitas (Unit/Pcs)</label>
        <input type="number" x-model.number="form.qty" class="form-input">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tanggal Produksi</label>
          <input type="date" x-model="form.prod_date" class="form-input">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tanggal Kedaluwarsa</label>
          <input type="date" x-model="form.exp_date" class="form-input">
        </div>
      </div>

      <!-- Live Calculation -->
      <div class="calc-box flex items-center justify-between">
        <div>
          <p class="text-xs text-slate-500 uppercase font-bold">Estimasi Masa Berlaku</p>
          <p class="text-sm font-bold text-slate-700 mt-1" x-text="daysValid + ' Hari'"></p>
        </div>
        <div class="text-right">
          <p class="text-xs text-slate-500 uppercase font-bold">Status Kualitas</p>
          <span class="text-xs font-bold px-2 py-1 rounded mt-1 inline-block" 
                :class="expiryStatusColor" x-text="expiryStatusText"></span>
        </div>
      </div>

      <div class="pt-6 flex justify-end gap-3">
        <button type="button" onclick="history.back()" class="px-6 py-2.5 rounded-lg text-sm font-bold text-slate-600 hover:bg-slate-100 transition">Batal</button>
        <button type="submit" class="px-8 py-2.5 rounded-lg text-sm font-bold bg-slate-800 text-white shadow-lg shadow-slate-300 hover:bg-slate-700 transition">
          Simpan Batch
        </button>
      </div>
    </form>
  </div>

</div>
{% endblock %}

{% block scripts %}
{{ variants_data|json_script:"variants-data" }}
{{ locations_data|json_script:"locations-data" }}
{{ zones_data|json_script:"zones-data" }}
<script>
function batchFormApp() {
  return {
    variants: [],
    locations: [],
    zones: [],
    form: {
      code: 'BCH-' + new Date().getFullYear() + '-NEW',
      variant_id: '',
      location_id: '',
      zone_id: '',
      qty: '',
      prod_date: '',
      exp_date: ''
    },
    init() {
      const vEl = document.getElementById('variants-data');
      const lEl = document.getElementById('locations-data');
      const zEl = document.getElementById('zones-data');
      if (vEl && vEl.textContent) { try { this.variants = JSON.parse(vEl.textContent) || []; } catch(e) { this.variants = []; } }
      if (lEl && lEl.textContent) { try { this.locations = JSON.parse(lEl.textContent) || []; } catch(e) { this.locations = []; } }
      if (zEl && zEl.textContent) { try { this.zones = JSON.parse(zEl.textContent) || []; } catch(e) { this.zones = []; } }
    },
    get filteredZones() {
      if (!this.form.location_id) return [];
      return this.zones.filter(z => String(z.location_id) === String(this.form.location_id));
    },
    get daysValid() {
      if(!this.form.prod_date || !this.form.exp_date) return 0;
      const start = new Date(this.form.prod_date);
      const end = new Date(this.form.exp_date);
      const diff = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
      return diff > 0 ? diff : 0;
    },
    get expiryStatusText() {
      const d = this.daysValid;
      if(d < 180) return 'Short Life';
      if(d < 365) return 'Medium Life';
      return 'Long Life';
    },
    get expiryStatusColor() {
      const d = this.daysValid;
      if(d < 180) return 'bg-rose-100 text-rose-600';
      if(d < 365) return 'bg-amber-100 text-amber-600';
      return 'bg-emerald-100 text-emerald-600';
    },
    submitForm() {
      if (!this.form.variant_id || !this.form.location_id) {
        alert('Mohon pilih Produk dan Lokasi');
        return;
      }
      const payload = {
        variant_id: this.form.variant_id,
        location_id: this.form.location_id,
        zone_id: this.form.zone_id || null,
        code: this.form.code,
        quantity_on_hand: this.form.qty || 0,
        production_date: this.form.prod_date || null,
        expiry_date: this.form.exp_date || null,
      };

      const getCookie = (name) => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
      };

      fetch('{{ submit_url }}', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': getCookie('csrftoken'),
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      })
      .then(r => r.json().then(j => ({ ok: r.ok, j })))
      .then(({ ok, j }) => {
        if (!ok || !j.success) throw new Error(j.error || 'Gagal menyimpan batch');
        window.location.href = '{% url 'batch_list' %}';
      })
      .catch(e => alert(e.message || 'Terjadi kesalahan'));
    }
  }
}
</script>
{% endblock %}
