# ============================================================================
# LUMRA DJANGO SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy file ini menjadi .env dan sesuaikan dengan environment Anda
# JANGAN commit .env file ke repository!
# ============================================================================

# ============ DJANGO CORE SETTINGS ============
# Secret key untuk production HARUS di-generate ulang!
# Gunakan: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-$@)ygpn3l2coujup$(0@_swfefep_0#re8-jzjb(u(!dz^pq^1

# Debug mode - SELALU False di production!
# Set True untuk development lokal agar static files bisa disajikan oleh Django
DEBUG=True

# Environment: development, staging, production
ENVIRONMENT=development

# Allowed hosts - pisahkan dengan koma
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============ DATABASE POSTGRESQL ============
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lumra_set_allegra
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# ============ REDIS CONFIGURATION ============
# Format: redis://[password@]host:port/database
REDIS_URL=redis://127.0.0.1:6379/1

# ============ CELERY CONFIGURATION ============
# Message broker (untuk task queue)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Result backend (untuk menyimpan hasil task)
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============ MEILISEARCH CONFIGURATION ============
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey

# Jika menggunakan Elasticsearch sebagai alternatif:
# ELASTICSEARCH_HOSTS=localhost:9200
# ELASTICSEARCH_INDEX_PREFIX=lumra

# ============ SENTRY ERROR TRACKING ============
# Optional - jika ingin error tracking ke Sentry
# Format: https://[key]@[domain].ingest.sentry.io/[project-id]
SENTRY_DSN=

# Environment tag di Sentry
SENTRY_ENVIRONMENT=development

# ============ EMAIL CONFIGURATION ============
# SMTP backend untuk production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Menggunakan Gmail SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password

# Menggunakan SendGrid
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=sg_xxxxxxxxxxxxx

# Dari address untuk semua email
DEFAULT_FROM_EMAIL=noreply@lumra.local
SERVER_EMAIL=server@lumra.local

# ============ CORS CONFIGURATION ============
# Allowed origins untuk CORS - pisahkan dengan koma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Allow credentials (cookies) dalam cross-origin requests
CORS_ALLOW_CREDENTIALS=True

# ============ SECURITY SETTINGS ============
# CSRF trusted origins - pisahkan dengan koma
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://yourdomain.com

# Internal IPs untuk debug toolbar
INTERNAL_IPS=127.0.0.1,localhost

# HTTPS redirect (hanya di production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS headers
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ============ SECURITY HEADERS ============
# Content Security Policy
CSP_DEFAULT_SRC=("'self'",)
CSP_SCRIPT_SRC=("'self'", "'unsafe-inline'", "cdn.tailwindcss.com")
CSP_STYLE_SRC=("'self'", "'unsafe-inline'", "cdn.tailwindcss.com")
CSP_IMG_SRC=("'self'", "data:", "https:")

# ============ AXES (BRUTE FORCE PROTECTION) ============
# Jumlah percobaan login yang gagal sebelum lockout
AXES_FAILURE_LIMIT=5
# Durasi lockout dalam jam
AXES_COOLOFF_DURATION=1
# Lockout berdasarkan kombinasi user + IP
AXES_LOCK_OUT_BY_COMBINATION_USER_AND_IP=True

# ============ PASSWORD VALIDATION ============
# Minimum panjang password (default: 12)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL_CHARS=True

# ============ DJANGO SILK PROFILING ============
# Enable request/response profiling (development only!)
SILK_PROFILING_ENABLED=False

# ============ DJANGO DEBUG TOOLBAR ============
# Enable debug toolbar (development only!)
DEBUG_TOOLBAR_ENABLED=False

# ============ NPM & BUILD TOOLS ============
# Path ke npm executable (otomatis dideteksi di settings.py)
# Uncomment dan sesuaikan jika perlu override:
# NPM_BIN_PATH=/usr/bin/npm

# ============ LOGGING ============
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Path untuk log files
LOG_DIR=logs
# Ukuran max file sebelum rotate (MB)
LOG_MAX_SIZE=10
# Jumlah backup files untuk rotate
LOG_BACKUP_COUNT=10

# ============ CACHING ============
# Cache timeout default (detik)
CACHE_TIMEOUT=300
# Cachalot query cache timeout (detik)
CACHALOT_TIMEOUT=3600

# ============ PAGINATION ============
# Default page size untuk API pagination
DEFAULT_PAGE_SIZE=50
# Maximum page size yang diizinkan
MAX_PAGE_SIZE=1000

# ============ RATE LIMITING ============
# Rate limit untuk API (requests per minute)
RATELIMIT_ENABLE=True
RATELIMIT_VIEW=100  # Per IP per minute
RATELIMIT_AUTH=500  # Authenticated users

# ============ FILE UPLOADS ============
# Maximum file upload size (bytes) - 10MB
MAX_UPLOAD_SIZE=10485760
# Allowed file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,xlsx,xls,doc,docx

# ============ AWS S3 (untuk static/media files) ============
# Jika menggunakan S3 untuk storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1

# ============ EXTERNAL APIs ============
# Google Maps API (jika ada fitur maps)
GOOGLE_MAPS_API_KEY=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ TIMEOUTS ============
# Database connection timeout (detik)
DB_CONN_TIMEOUT=10
# Redis connection timeout (detik)
REDIS_CONN_TIMEOUT=5
# Task execution timeout (detik)
CELERY_TASK_TIMEOUT=1800

# ============ MONITORING & ANALYTICS ============
# Sentry sample rate (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable Prometheus metrics export
PROMETHEUS_METRICS_ENABLED=True

# ============ FEATURE FLAGS ============
# Feature toggling untuk A/B testing
FEATURE_NEW_DASHBOARD=False
FEATURE_ADVANCED_REPORTS=True
FEATURE_EXPORT_TO_PDF=True
FEATURE_REAL_TIME_NOTIFICATIONS=True

# ============ PERFORMANCE ============
# Enable query optimization
QUERY_OPTIMIZATION=True
# Enable caching
CACHING_ENABLED=True
# Enable compression
COMPRESSION_ENABLED=True
# Enable async tasks
ASYNC_TASKS_ENABLED=True

# ============ TIME & LOCALE ============
# Timezone
TIME_ZONE=Asia/Jakarta
# Language code
LANGUAGE_CODE=id
# Use localization
USE_I18N=True
USE_TZ=True

# ============ APP VERSIONING ============
APP_VERSION=2.0.0
APP_NAME=Lumra - Advanced Inventory System
BUILD_DATE=2024-01-01
BUILD_COMMIT=main

# ============ DEVELOPMENT ONLY ============
# Allow test data generation
ALLOW_TEST_DATA=True
# Print SQL queries di console
DEBUG_SQL=False
# Profile slow queries (ms)
SLOW_QUERY_THRESHOLD=500

# ============================================================================
# NOTES:
# 1. Untuk production, gunakan strong SECRET_KEY
# 2. Jangan hardcode credentials, gunakan environment variables
# 3. Enable HTTPS & SECURE flags di production
# 4. Setup proper logging & monitoring
# 5. Regularly rotate API keys & credentials
# 6. Test security settings sebelum deploy
# ============================================================================
